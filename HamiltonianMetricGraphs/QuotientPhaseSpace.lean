import HamiltonianMetricGraphs.PhaseSpace
import Mathlib.Logic.Relation

/-!
# The scattering quotient phase space

Boundary identifications are generated by the prescribed incoming-to-outgoing scattering
maps.  We use `Relation.EqvGen.setoid` so the quotient is a genuine Lean quotient from the
definition, without assuming an equivalence relation as an axiom.
-/

namespace HamiltonianMetricGraphs

namespace MechanicalPotential

variable {Γ : FiniteMetricGraph} (V : MechanicalPotential Γ)
variable (S : BorelEnergyPreservingScattering V)

/-- One directed boundary-scattering identification before taking its equivalence closure. -/
def scatteringStep : Γ.NonzeroPrequotientPhase → Γ.NonzeroPrequotientPhase → Prop := fun x y =>
  ∃ (v : Γ.Vertex) (α : Γ.IncomingBoundary v),
    x = α.1.toNonzeroPrequotientPhase Γ ∧
      y = (S.map v α).1.toNonzeroPrequotientPhase Γ

/-- The quotient setoid generated by all vertex-scattering identifications. -/
def scatteringSetoid : Setoid Γ.NonzeroPrequotientPhase :=
  Relation.EqvGen.setoid (scatteringStep (V := V) S)

/-- The measurable construction will equip this quotient with the coinduced Borel structure. -/
def ScatteringPhaseSpace := Quotient (scatteringSetoid (V := V) S)

noncomputable instance : MeasurableSpace (ScatteringPhaseSpace (V := V) S) :=
  MeasurableSpace.map
    (Quotient.mk'' : Γ.NonzeroPrequotientPhase → ScatteringPhaseSpace (V := V) S) inferInstance

/-- The canonical map from the nonzero prequotient cylinder union to the scattering quotient. -/
def quotientMap : Γ.NonzeroPrequotientPhase → ScatteringPhaseSpace (V := V) S :=
  Quotient.mk''

@[fun_prop] theorem measurable_quotientMap :
    Measurable (quotientMap (V := V) S) := by
  exact measurable_quotient_mk''

/-- The quotient uses the induced/coinduced sigma-algebra: a quotient set is Borel exactly
when its full preimage in the nonzero prequotient phase space is Borel. -/
theorem measurableSet_quotient_iff {A : Set (ScatteringPhaseSpace (V := V) S)} :
    MeasurableSet A ↔ MeasurableSet ((quotientMap (V := V) S) ⁻¹' A) := by
  rfl

theorem scatteringStep_irreflexive (x : Γ.NonzeroPrequotientPhase) :
    ¬ scatteringStep (V := V) S x x := by
  rintro ⟨v, α, hx, hy⟩
  rw [hx] at hy
  exact FiniteMetricGraph.incoming_outgoing_nonzeroPrequotient_ne Γ α (S.map v α) hy

theorem scatteringStep_functional {x y z : Γ.NonzeroPrequotientPhase}
    (hxy : scatteringStep (V := V) S x y) (hxz : scatteringStep (V := V) S x z) : y = z := by
  rcases hxy with ⟨v, α, hx, hy⟩
  rcases hxz with ⟨w, β, hx', hz⟩
  have hcov : α.1 = β.1 :=
    FiniteMetricGraph.BoundaryCovector.toNonzeroPrequotientPhase_injective Γ (hx.symm.trans hx')
  have hvw : v = w := by
    calc
      v = α.1.germ.vertex := α.2.1.symm
      _ = β.1.germ.vertex := by rw [hcov]
      _ = w := β.2.1
  subst w
  have hab : α = β := Subtype.ext hcov
  subst β
  exact hy.trans hz.symm

theorem scatteringStep_cofunctional {x y z : Γ.NonzeroPrequotientPhase}
    (hxy : scatteringStep (V := V) S x y) (hzy : scatteringStep (V := V) S z y) : x = z := by
  rcases hxy with ⟨v, α, hx, hy⟩
  rcases hzy with ⟨w, β, hz, hy'⟩
  have hcov : (S.map v α).1 = (S.map w β).1 :=
    FiniteMetricGraph.BoundaryCovector.toNonzeroPrequotientPhase_injective Γ (hy.symm.trans hy')
  have hvw : v = w := by
    calc
      v = (S.map v α).1.germ.vertex := (S.map v α).2.1.symm
      _ = (S.map w β).1.germ.vertex := by rw [hcov]
      _ = w := (S.map w β).2.1
  subst w
  have himage : S.map v α = S.map v β := Subtype.ext hcov
  have hab : α = β := (S.map v).injective himage
  subst β
  exact hx.trans hz.symm

theorem no_scatteringStep_after_scattering {x y z : Γ.NonzeroPrequotientPhase}
    (hxy : scatteringStep (V := V) S x y) : ¬ scatteringStep (V := V) S y z := by
  rintro ⟨w, β, hy, hz⟩
  rcases hxy with ⟨v, α, hx, hy'⟩
  have hboundary : β.1.toNonzeroPrequotientPhase Γ =
      (S.map v α).1.toNonzeroPrequotientPhase Γ := hy.symm.trans hy'
  exact FiniteMetricGraph.incoming_outgoing_nonzeroPrequotient_ne Γ β (S.map v α) hboundary

/-- Equality or one scattering identification in either direction.  The next theorem proves
this already is an equivalence relation, so the generated quotient has no larger classes. -/
def scatteringNeighbor (x y : Γ.NonzeroPrequotientPhase) : Prop :=
  x = y ∨ scatteringStep (V := V) S x y ∨ scatteringStep (V := V) S y x

theorem scatteringNeighbor_equivalence :
    Equivalence (scatteringNeighbor (V := V) S) := by
  refine ⟨fun x => Or.inl rfl, ?_, ?_⟩
  · intro x y h
    rcases h with h | h | h
    · exact Or.inl h.symm
    · exact Or.inr (Or.inr h)
    · exact Or.inr (Or.inl h)
  · intro x y z hxy hyz
    rcases hxy with hxy | hxy | hxy
    · subst y
      exact hyz
    · rcases hyz with hyz | hyz | hyz
      · subst z
        exact Or.inr (Or.inl hxy)
      · exact False.elim (no_scatteringStep_after_scattering (V := V) S hxy hyz)
      · exact Or.inl (scatteringStep_cofunctional (V := V) S hxy hyz)
    · rcases hyz with hyz | hyz | hyz
      · subst z
        exact Or.inr (Or.inr hxy)
      · exact Or.inl (scatteringStep_functional (V := V) S hxy hyz)
      · exact False.elim (no_scatteringStep_after_scattering (V := V) S hyz hxy)

/-- Normal form for generated scattering equivalence classes.  A class is either a singleton
or the pair consisting of one incoming covector and its prescribed outgoing image. -/
theorem scatteringEqv_iff_neighbor (x y : Γ.NonzeroPrequotientPhase) :
    (scatteringSetoid (V := V) S) x y ↔ scatteringNeighbor (V := V) S x y := by
  constructor
  · intro hxy
    have hgen : Relation.EqvGen (scatteringNeighbor (V := V) S) x y :=
      Relation.EqvGen.mono (fun _ _ h => Or.inr (Or.inl h)) hxy
    exact (scatteringNeighbor_equivalence (V := V) S).eqvGen_iff.mp hgen
  · intro hxy
    rcases hxy with hxy | hxy | hxy
    · subst y
      exact Relation.EqvGen.refl _
    · exact Relation.EqvGen.rel _ _ hxy
    · exact Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ hxy)

/-- The prequotient points which are incoming boundary covectors. -/
def IsIncomingPoint (V : MechanicalPotential Γ) (_S : BorelEnergyPreservingScattering V)
    (x : Γ.NonzeroPrequotientPhase) : Prop :=
  ∃ (v : Γ.Vertex) (α : Γ.IncomingBoundary v), x = α.1.toNonzeroPrequotientPhase Γ

/-- Closed-form characterisation of the incoming prequotient points: they are exactly the
germ-coordinate points with inward momentum sign.  This makes the incoming set (and hence the
outgoing representative section) Borel. -/
theorem isIncomingPoint_iff (x : Γ.NonzeroPrequotientPhase) :
    IsIncomingPoint (V := V) S x ↔
      (x.1.2.1.1 = 0 ∧ x.1.2.1.2 < 0) ∨
      (x.1.2.1.1 = Γ.length x.1.1 ∧ 0 < x.1.2.1.2) := by
  constructor
  · rintro ⟨v, ⟨⟨⟨e', b⟩, mom, hmom⟩, hv, hsign⟩, hxeq⟩
    have hval := congrArg Subtype.val hxeq
    have hcoord : x.1.2.1.1 = FiniteMetricGraph.EdgeEnd.coordinate Γ (e', b) :=
      congrArg (fun z : Γ.PrequotientPhase => z.2.1.1) hval
    have hmomeq : x.1.2.1.2 = mom :=
      congrArg (fun z : Γ.PrequotientPhase => z.2.1.2) hval
    have hedge : x.1.1 = e' := congrArg Sigma.fst hval
    cases b
    · left
      refine ⟨?_, ?_⟩
      · rw [hcoord]; rfl
      · rw [hmomeq]
        have hs : FiniteMetricGraph.EdgeEnd.sign Γ (e', false) = -1 := rfl
        rw [hs] at hsign; linarith
    · right
      refine ⟨?_, ?_⟩
      · rw [hcoord, hedge]; rfl
      · rw [hmomeq]
        have hs : FiniteMetricGraph.EdgeEnd.sign Γ (e', true) = 1 := rfl
        rw [hs] at hsign; linarith
  · intro h
    obtain ⟨⟨e, ⟨⟨q, p⟩, hq⟩⟩, hp⟩ := x
    rcases h with ⟨hpos, hmom⟩ | ⟨hpos, hmom⟩
    · change q = 0 at hpos
      change p < 0 at hmom
      refine ⟨Γ.endpoint e false, ⟨⟨(e, false), p, hmom.ne⟩, rfl, ?_⟩, ?_⟩
      · show FiniteMetricGraph.EdgeEnd.sign Γ (e, false) * p > 0
        have hs : FiniteMetricGraph.EdgeEnd.sign Γ (e, false) = -1 := rfl
        rw [hs]; linarith
      · apply Subtype.ext
        subst hpos
        rfl
    · change q = Γ.length e at hpos
      change 0 < p at hmom
      refine ⟨Γ.endpoint e true, ⟨⟨(e, true), p, hmom.ne'⟩, rfl, ?_⟩, ?_⟩
      · show FiniteMetricGraph.EdgeEnd.sign Γ (e, true) * p > 0
        have hs : FiniteMetricGraph.EdgeEnd.sign Γ (e, true) = 1 := rfl
        rw [hs]; linarith
      · apply Subtype.ext
        subst hpos
        rfl

/-- The set of incoming prequotient points is Borel. -/
theorem measurableSet_isIncomingPoint :
    MeasurableSet {x : Γ.NonzeroPrequotientPhase | IsIncomingPoint (V := V) S x} := by
  have hpos : Measurable (fun x : Γ.NonzeroPrequotientPhase => x.1.2.1.1) :=
    measurable_prequotientPosition.comp measurable_subtype_coe
  have hmom : Measurable (fun x : Γ.NonzeroPrequotientPhase => x.1.2.1.2) :=
    measurable_prequotientMomentum.comp measurable_subtype_coe
  have hlen : Measurable (fun x : Γ.NonzeroPrequotientPhase => Γ.length x.1.1) :=
    measurable_prequotientLength.comp measurable_subtype_coe
  have hset : {x : Γ.NonzeroPrequotientPhase | IsIncomingPoint (V := V) S x} =
      ((fun x : Γ.NonzeroPrequotientPhase => x.1.2.1.1) ⁻¹' {0} ∩
        (fun x : Γ.NonzeroPrequotientPhase => x.1.2.1.2) ⁻¹' Set.Iio 0) ∪
      ((fun x : Γ.NonzeroPrequotientPhase => x.1.2.1.1 - Γ.length x.1.1) ⁻¹' {0} ∩
        (fun x : Γ.NonzeroPrequotientPhase => x.1.2.1.2) ⁻¹' Set.Ioi 0) := by
    ext x
    rw [Set.mem_setOf_eq, isIncomingPoint_iff]
    simp only [Set.mem_union, Set.mem_inter_iff, Set.mem_preimage, Set.mem_singleton_iff,
      Set.mem_Iio, Set.mem_Ioi, sub_eq_zero]
  rw [hset]
  exact ((hpos (measurableSet_singleton 0)).inter (hmom measurableSet_Iio)).union
    (((hpos.sub hlen) (measurableSet_singleton 0)).inter (hmom measurableSet_Ioi))

/-- The outgoing representative section: edge interiors together with outgoing boundary points. -/
def OutgoingRepresentativeSpace (V : MechanicalPotential Γ)
    (S : BorelEnergyPreservingScattering V) :=
  {x : Γ.NonzeroPrequotientPhase | ¬ IsIncomingPoint (V := V) S x}

/-- The outgoing representative section is Borel (the complement of the incoming set). -/
theorem measurableSet_outgoingRepresentativeSpace :
    MeasurableSet (OutgoingRepresentativeSpace (V := V) S) :=
  (measurableSet_isIncomingPoint (V := V) S).compl

theorem scatteringStep_source_isIncoming {x y : Γ.NonzeroPrequotientPhase}
    (hxy : scatteringStep (V := V) S x y) : IsIncomingPoint (V := V) S x := by
  rcases hxy with ⟨v, α, hx, -⟩
  exact ⟨v, α, hx⟩

theorem scatteringStep_target_notIncoming {x y : Γ.NonzeroPrequotientPhase}
    (hxy : scatteringStep (V := V) S x y) : ¬ IsIncomingPoint (V := V) S y := by
  intro hy
  rcases hy with ⟨w, β, hy⟩
  apply no_scatteringStep_after_scattering (V := V) S hxy
  exact ⟨w, β, hy, rfl⟩

/-- Each scattering quotient class has an outgoing representative. -/
theorem exists_outgoingRepresentative (x : Γ.NonzeroPrequotientPhase) :
    ∃ y : OutgoingRepresentativeSpace (V := V) S,
      quotientMap (V := V) S y.1 = quotientMap (V := V) S x := by
  by_cases hx : IsIncomingPoint (V := V) S x
  · rcases hx with ⟨v, α, hx⟩
    let y : Γ.NonzeroPrequotientPhase := (S.map v α).1.toNonzeroPrequotientPhase Γ
    have hstep : scatteringStep (V := V) S x y := ⟨v, α, hx, rfl⟩
    refine ⟨⟨y, scatteringStep_target_notIncoming (V := V) S hstep⟩, ?_⟩
    exact (Quotient.sound (Relation.EqvGen.rel _ _ hstep)).symm
  · exact ⟨⟨x, hx⟩, rfl⟩

theorem outgoingRepresentative_unique {x y : OutgoingRepresentativeSpace (V := V) S}
    (hxy : quotientMap (V := V) S x.1 = quotientMap (V := V) S y.1) : x = y := by
  apply Subtype.ext
  have hrel : (scatteringSetoid (V := V) S) x.1 y.1 := Quotient.exact hxy
  rcases (scatteringEqv_iff_neighbor (V := V) S x.1 y.1).mp hrel with h | h | h
  · exact h
  · exact False.elim (x.2 (scatteringStep_source_isIncoming (V := V) S h))
  · exact False.elim (y.2 (scatteringStep_source_isIncoming (V := V) S h))

def outgoingRepresentativeMap : OutgoingRepresentativeSpace (V := V) S →
    ScatteringPhaseSpace (V := V) S := fun x => quotientMap (V := V) S x.1

theorem outgoingRepresentativeMap_bijective :
    Function.Bijective (outgoingRepresentativeMap (V := V) S) := by
  constructor
  · intro x y hxy
    exact outgoingRepresentative_unique (V := V) S hxy
  · intro z
    refine Quotient.inductionOn' z ?_
    intro x
    rcases exists_outgoingRepresentative (V := V) S x with ⟨y, hy⟩
    exact ⟨y, hy⟩

/-- The outgoing representative map (quotient projection of the representative) is measurable. -/
theorem measurable_outgoingRepresentativeMap :
    Measurable (outgoingRepresentativeMap (V := V) S) :=
  (measurable_quotientMap (V := V) S).comp measurable_subtype_coe

/-- Scattering an incoming covector to its outgoing nonzero prequotient point is measurable at
each vertex: the (measurable) scattering equivalence followed by the measurable covector
embedding.  This is the local building block of the scattering-step measurability. -/
theorem measurable_scatterIncoming (v : Γ.Vertex) :
    Measurable (fun α : Γ.IncomingBoundary v =>
      (S.map v α).1.toNonzeroPrequotientPhase Γ) :=
  (Γ.measurable_toNonzeroPrequotientPhase).comp
    (measurable_subtype_coe.comp (S.map v).measurable)

/-- Set-theoretic outgoing chart for the scattering quotient. -/
noncomputable def outgoingChart :
    ScatteringPhaseSpace (V := V) S ≃ OutgoingRepresentativeSpace (V := V) S :=
  (Equiv.ofBijective (outgoingRepresentativeMap (V := V) S)
    (outgoingRepresentativeMap_bijective (V := V) S)).symm

theorem scatteringStep_hamiltonian (x y : Γ.NonzeroPrequotientPhase)
    (hxy : scatteringStep (V := V) S x y) :
    V.prequotientHamiltonian x.1 = V.prequotientHamiltonian y.1 := by
  rcases hxy with ⟨v, α, rfl, rfl⟩
  change V.prequotientHamiltonian (α.1.toPrequotientPhase Γ) =
    V.prequotientHamiltonian ((S.map v α).1.toPrequotientPhase Γ)
  rw [V.prequotientHamiltonian_boundary, V.prequotientHamiltonian_boundary]
  exact (S.preserves_energy v α).symm

theorem scatteringEqv_hamiltonian (x y : Γ.NonzeroPrequotientPhase)
    (hxy : (scatteringSetoid (V := V) S) x y) :
    V.prequotientHamiltonian x.1 = V.prequotientHamiltonian y.1 := by
  induction hxy with
  | rel _ _ h => exact scatteringStep_hamiltonian (V := V) S _ _ h
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- The Hamiltonian descends to the scattering quotient because every generated boundary
identification preserves energy. -/
noncomputable def quotientHamiltonian : ScatteringPhaseSpace (V := V) S → ℝ :=
  Quotient.lift (fun x : Γ.NonzeroPrequotientPhase => V.prequotientHamiltonian x.1)
    (fun x y hxy => scatteringEqv_hamiltonian (V := V) S x y hxy)

@[simp] theorem quotientHamiltonian_mk (x : Γ.NonzeroPrequotientPhase) :
    quotientHamiltonian (V := V) S (quotientMap (V := V) S x) =
      V.prequotientHamiltonian x.1 := rfl

/-- The quotient Hamiltonian is Borel measurable: it lifts the measurable prequotient
Hamiltonian along the coinduced quotient σ-algebra. -/
theorem measurable_quotientHamiltonian : Measurable (quotientHamiltonian (V := V) S) := by
  intro A hA
  rw [measurableSet_quotient_iff]
  have hset : (quotientMap (V := V) S) ⁻¹' (quotientHamiltonian (V := V) S ⁻¹' A) =
      (fun x : Γ.NonzeroPrequotientPhase => V.prequotientHamiltonian x.1) ⁻¹' A := by
    ext x; simp
  rw [hset]
  exact (V.measurable_prequotientHamiltonian.comp measurable_subtype_coe) hA

/-- The regular sector in the quotient phase space. -/
def RegularScatteringPhaseSpace :=
  {z : ScatteringPhaseSpace (V := V) S |
    quotientHamiltonian (V := V) S z ∉ V.exceptionalEnergies}

/-- The regular sector of the scattering quotient is Borel: it is the preimage of the complement
of the finite exceptional-energy set under the measurable quotient Hamiltonian. -/
theorem measurableSet_regularScatteringPhaseSpace :
    MeasurableSet (RegularScatteringPhaseSpace (V := V) S) := by
  have hE : MeasurableSet ((V.exceptionalEnergies : Set ℝ)) := V.exceptionalEnergies.measurableSet
  exact (measurable_quotientHamiltonian (V := V) S) hE.compl

end MechanicalPotential
end HamiltonianMetricGraphs
