import Mathlib

/-!
# Ribbon graphs and the Euler formula (Proposition XI.1, combinatorial part)

Proposition XI.1 of the paper identifies the high-energy end permutation `Π_E` with the face
permutation of a ribbon graph and counts its cycles by Euler's formula
`#cyc(Π_E) = 2 - 2g - #V + #E`, `g` the genus of the associated closed orientable surface.
Mathlib has no theory of surfaces of combinatorial maps, so this file develops the combinatorial
content of that formula.

## Ribbon graphs

A ribbon graph with edge set `E` (`RibbonGraph E`) is a **rotation** `σ` of the dart set
`E × Bool`: the darts are the two ends `(e, false)`, `(e, true)` of every edge, exactly as the
edge-ends `Γ.EdgeEnd = Γ.Edge × Bool` of a metric graph.  The **edge involution**
`α (e, b) = (e, !b)` (`edgeInv`) pairs the two ends of each edge; it is a fixed-point-free
involution.  The vertices are the cycles of `σ`, the edges the cycles of `α` (one per element of
`E`), and the faces the cycles of the **face permutation** `φ = σ ∘ α` (`facePerm`), which is the
convention `Π_E = F_E ∘ κ_E` of the paper with `F_E = σ` and `κ_E = α`.

The number of cycles of a permutation counts its fixed points as cycles (`numOrbits`): a vertex of
degree one is a fixed point of `σ`, and it is a vertex.

## The genus

The Euler characteristic is `χ = #V - #E + #F` (`eulerChar`).  The main theorem of this file is that
for a **connected** ribbon graph (the group `⟨σ, α⟩` acts transitively on the darts,
`RibbonGraph.Connected`)

* `χ` is even (`even_eulerChar`; this holds for every ribbon graph), and
* `χ ≤ 2` (`eulerChar_le_two`),

so that `g = (2 - χ) / 2` (`genus`) is a natural number with `χ = 2 - 2g` (`eulerChar_eq`), i.e.
`#F = 2 - 2g - #V + #E` (`numFaces_eq`).  This combinatorial genus is the genus of the closed
orientable surface obtained by gluing a disc into every face of the ribbon graph; that the surface
is closed and orientable with Euler characteristic `χ`, and that `χ = 2 - 2g` for its topological
genus `g`, is the classification of surfaces, which is not in Mathlib.  Here `g` is *defined* by
`χ = 2 - 2g`, and the content that is proved is precisely what makes this definition meaningful:
`χ` is even and at most `2`.

## The proof

Write `α` as the product of the `#E` transpositions `(e, false) ↔ (e, true)`.  Multiplying a
permutation `π` on the right by a transposition `(x y)` changes its number of cycles by exactly one
(`numOrbits_mul_swap_of_not_sameCycle`, `numOrbits_mul_swap_of_sameCycle`): it joins the cycles of
`x` and `y` if they are different and cuts the common cycle otherwise.  This gives the parity.
For the bound, follow the components of the relation generated by `σ` and the transpositions used
so far: a transposition joining two components joins two cycles, and connectivity forces
`#V - 1` such joins (`numOrbits_mul_swapProd_add_le`, `even_numOrbits_mul_swapProd`).
-/

namespace HamiltonianMetricGraphs

open Finset Equiv

/-! ### Counting the classes of an equivalence relation -/

section Classes

variable {D : Type*} [Fintype D] [DecidableEq D]

/-- The number of classes of a (decidable) relation `r` on a finite type: the number of distinct
sets `{w | r d w}`.  For an equivalence relation this is the number of equivalence classes. -/
def numClasses (r : D → D → Prop) [DecidableRel r] : ℕ :=
  (univ.image fun d => univ.filter (r d)).card

theorem numClasses_congr (r r' : D → D → Prop) [DecidableRel r] [DecidableRel r']
    (h : ∀ z w, r z w ↔ r' z w) : numClasses r = numClasses r' := by
  unfold numClasses
  have : (fun d => univ.filter (r d)) = fun d => univ.filter (r' d) := by
    funext d
    ext w
    simp [h]
  rw [this]

/-- A total relation has at most one class. -/
theorem numClasses_le_one_of_forall (r : D → D → Prop) [DecidableRel r] (h : ∀ z w, r z w) :
    numClasses r ≤ 1 := by
  unfold numClasses
  have : (univ.image fun d => univ.filter (r d)) ⊆ {univ} := by
    intro c hc
    obtain ⟨d, -, rfl⟩ := mem_image.mp hc
    rw [mem_singleton]
    ext w
    simp [h d w]
  exact (card_le_card this).trans (card_singleton _).le

/-- **Merging two classes.**  If `r'` is obtained from the equivalence relation `r` by merging the
two different classes of `x` and `y`, then `r'` has one class less. -/
theorem numClasses_merge (r r' : D → D → Prop) [DecidableRel r] [DecidableRel r']
    (hr : Equivalence r) {x y : D} (hxy : ¬ r x y)
    (h' : ∀ z w, r' z w ↔ r z w ∨ ((r z x ∨ r z y) ∧ (r w x ∨ r w y))) :
    numClasses r' + 1 = numClasses r := by
  classical
  set C : D → Finset D := fun d => univ.filter (r d) with hC
  set C' : D → Finset D := fun d => univ.filter (r' d) with hC'
  set A : Finset D := univ.filter fun z => ¬ (r z x ∨ r z y) with hA
  -- outside the two merged classes nothing changes
  have hout : ∀ z, ¬ (r z x ∨ r z y) → C' z = C z := by
    intro z hz
    ext w
    simp only [hC, hC', mem_filter, mem_univ, true_and, h']
    constructor
    · rintro (h | ⟨h, -⟩)
      · exact h
      · exact absurd h hz
    · exact Or.inl
  -- inside, the class is the union of the two classes
  have hin : ∀ z, (r z x ∨ r z y) → C' z = C x ∪ C y := by
    intro z hz
    ext w
    simp only [hC, hC', mem_filter, mem_univ, true_and, mem_union, h']
    constructor
    · rintro (h | ⟨-, h⟩)
      · rcases hz with hz | hz
        · exact Or.inl (hr.trans (hr.symm hz) h)
        · exact Or.inr (hr.trans (hr.symm hz) h)
      · rcases h with h | h
        · exact Or.inl (hr.symm h)
        · exact Or.inr (hr.symm h)
    · intro h
      refine Or.inr ⟨hz, ?_⟩
      rcases h with h | h
      · exact Or.inl (hr.symm h)
      · exact Or.inr (hr.symm h)
  have hxA : ∀ z ∈ A, ¬ r z x ∧ ¬ r z y := by
    intro z hz
    simp only [hA, mem_filter, mem_univ, true_and, not_or] at hz
    exact hz
  have hx : x ∈ C x := by simp [hC, hr.refl x]
  have hy : y ∈ C y := by simp [hC, hr.refl y]
  have himage' : (univ.image C') = insert (C x ∪ C y) (A.image C) := by
    ext c
    simp only [mem_image, mem_univ, true_and, mem_insert]
    constructor
    · rintro ⟨z, rfl⟩
      by_cases hz : r z x ∨ r z y
      · exact Or.inl (hin z hz)
      · refine Or.inr ⟨z, ?_, (hout z hz).symm⟩
        simp only [hA, mem_filter, mem_univ, true_and]
        exact hz
    · rintro (rfl | ⟨z, hz, rfl⟩)
      · exact ⟨x, hin x (Or.inl (hr.refl x))⟩
      · refine ⟨z, hout z ?_⟩
        simpa [hA] using hz
  have himage : (univ.image C) = insert (C x) (insert (C y) (A.image C)) := by
    ext c
    simp only [mem_image, mem_univ, true_and, mem_insert]
    constructor
    · rintro ⟨z, rfl⟩
      by_cases hz : r z x ∨ r z y
      · rcases hz with hz | hz
        · left
          ext w
          simp only [hC, mem_filter, mem_univ, true_and]
          exact ⟨fun h => hr.trans (hr.symm hz) h, fun h => hr.trans hz h⟩
        · right; left
          ext w
          simp only [hC, mem_filter, mem_univ, true_and]
          exact ⟨fun h => hr.trans (hr.symm hz) h, fun h => hr.trans hz h⟩
      · exact Or.inr (Or.inr ⟨z, by simp only [hA, mem_filter, mem_univ, true_and]; exact hz, rfl⟩)
    · rintro (rfl | rfl | ⟨z, -, rfl⟩)
      · exact ⟨x, rfl⟩
      · exact ⟨y, rfl⟩
      · exact ⟨z, rfl⟩
  -- the new and the two old classes are not classes of points of `A`
  have hnot : ∀ c, x ∈ c ∨ y ∈ c → c ∉ A.image C := by
    intro c hc hcA
    obtain ⟨z, hz, rfl⟩ := mem_image.mp hcA
    have := hxA z hz
    rcases hc with hc | hc
    · exact this.1 (by simpa [hC] using hc)
    · exact this.2 (by simpa [hC] using hc)
  have hCxy : C x ∉ insert (C y) (A.image C) := by
    rw [mem_insert, not_or]
    refine ⟨fun h => ?_, hnot _ (Or.inl hx)⟩
    have : x ∈ C y := h ▸ hx
    exact hxy (hr.symm (by simpa [hC] using this))
  have hCy : C y ∉ A.image C := hnot _ (Or.inr hy)
  have hCu : C x ∪ C y ∉ A.image C := hnot _ (Or.inl (mem_union_left _ hx))
  unfold numClasses
  change (univ.image C').card + 1 = (univ.image C).card
  rw [himage', himage, card_insert_of_notMem hCu, card_insert_of_notMem hCxy,
    card_insert_of_notMem hCy]

end Classes

/-! ### Relations generated by steps -/

section EqvGen

variable {D : Type*}

theorem eqvGen_of_le {R R' : D → D → Prop} (h : ∀ a b, R a b → Relation.EqvGen R' a b)
    {a b : D} (hab : Relation.EqvGen R a b) : Relation.EqvGen R' a b := by
  induction hab with
  | rel x y hxy => exact h x y hxy
  | refl x => exact Relation.EqvGen.refl x
  | symm x y _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans x y z _ _ ih1 ih2 => exact Relation.EqvGen.trans _ _ _ ih1 ih2

/-- Adding one pair `(x, y)` to a relation merges the classes of `x` and `y` in the equivalence
relation it generates. -/
theorem eqvGen_or_pair_iff {R : D → D → Prop} {x y z w : D} :
    Relation.EqvGen (fun a b => R a b ∨ (a = x ∧ b = y)) z w ↔
      Relation.EqvGen R z w ∨
        ((Relation.EqvGen R z x ∨ Relation.EqvGen R z y) ∧
          (Relation.EqvGen R w x ∨ Relation.EqvGen R w y)) := by
  have he := Relation.EqvGen.is_equivalence R
  constructor
  · intro h
    induction h with
    | rel a b hab =>
        rcases hab with hab | ⟨rfl, rfl⟩
        · exact Or.inl (Relation.EqvGen.rel _ _ hab)
        · exact Or.inr ⟨Or.inl (he.refl _), Or.inr (he.refl _)⟩
    | refl a => exact Or.inl (he.refl a)
    | symm a b _ ih =>
        rcases ih with ih | ⟨h1, h2⟩
        · exact Or.inl (he.symm ih)
        · exact Or.inr ⟨h2, h1⟩
    | trans a b c _ _ ih1 ih2 =>
        rcases ih1 with ih1 | ⟨h1, h2⟩ <;> rcases ih2 with ih2 | ⟨h3, h4⟩
        · exact Or.inl (he.trans ih1 ih2)
        · refine Or.inr ⟨?_, h4⟩
          rcases h3 with h3 | h3
          · exact Or.inl (he.trans ih1 h3)
          · exact Or.inr (he.trans ih1 h3)
        · refine Or.inr ⟨h1, ?_⟩
          rcases h2 with h2 | h2
          · exact Or.inl (he.trans (he.symm ih2) h2)
          · exact Or.inr (he.trans (he.symm ih2) h2)
        · exact Or.inr ⟨h1, h4⟩
  · have hmono : ∀ {a b}, Relation.EqvGen R a b →
        Relation.EqvGen (fun a b => R a b ∨ (a = x ∧ b = y)) a b :=
      fun h => eqvGen_of_le (fun a b hab => Relation.EqvGen.rel _ _ (Or.inl hab)) h
    have hxy : Relation.EqvGen (fun a b => R a b ∨ (a = x ∧ b = y)) x y :=
      Relation.EqvGen.rel _ _ (Or.inr ⟨rfl, rfl⟩)
    have he' := Relation.EqvGen.is_equivalence (fun a b => R a b ∨ (a = x ∧ b = y))
    -- every point of the two classes is related to `x`
    have hx : ∀ {u}, (Relation.EqvGen R u x ∨ Relation.EqvGen R u y) →
        Relation.EqvGen (fun a b => R a b ∨ (a = x ∧ b = y)) u x := by
      intro u hu
      rcases hu with hu | hu
      · exact hmono hu
      · exact he'.trans (hmono hu) (he'.symm hxy)
    rintro (h | ⟨h1, h2⟩)
    · exact hmono h
    · exact he'.trans (hx h1) (he'.symm (hx h2))

end EqvGen

/-! ### Cycles of a permutation -/

section Orbits

variable {D : Type*} [Fintype D] [DecidableEq D]

/-- The **cycles** of a permutation, each as the finite set of its points.  Fixed points are
cycles of length one. -/
def permOrbits (π : Perm D) : Finset (Finset D) :=
  univ.image fun d => univ.filter (π.SameCycle d)

/-- The **number of cycles** `#cyc(π)` of a permutation, fixed points included. -/
def numOrbits (π : Perm D) : ℕ := (permOrbits π).card

theorem numOrbits_eq_numClasses (π : Perm D) : numOrbits π = numClasses π.SameCycle := rfl

omit [Fintype D] [DecidableEq D] in
theorem sameCycle_iff_exists_nat [Finite D] {π : Perm D} {a b : D} :
    π.SameCycle a b ↔ ∃ n : ℕ, (π ^ n) a = b :=
  ⟨fun h => h.exists_nat_pow_eq, fun ⟨n, hn⟩ => ⟨n, by rw [zpow_natCast, hn]⟩⟩

omit [Fintype D] [DecidableEq D] in
/-- A forward-invariant predicate is invariant along cycles. -/
theorem sameCycle_of_invariant [Finite D] {π : Perm D} (P : D → Prop) (hP : ∀ z, P z → P (π z))
    {a b : D} (hab : π.SameCycle a b) (ha : P a) : P b := by
  obtain ⟨n, rfl⟩ := sameCycle_iff_exists_nat.mp hab
  clear hab
  induction n with
  | zero => simpa using ha
  | succ n ih => rw [pow_succ', Perm.mul_apply]; exact hP _ ih

omit [Fintype D] [DecidableEq D] in
theorem minimalPeriod_perm_pos [Finite D] (π : Perm D) (a : D) :
    0 < Function.minimalPeriod π a := by
  apply Function.minimalPeriod_pos_of_mem_periodicPts
  refine ⟨orderOf π, orderOf_pos π, ?_⟩
  change (⇑π)^[orderOf π] a = a
  rw [← Perm.coe_pow, pow_orderOf_eq_one, Perm.coe_one, id]

omit [Fintype D] [DecidableEq D] in
theorem perm_pow_eq_iterate (π : Perm D) (n : ℕ) (a : D) : (π ^ n) a = (⇑π)^[n] a := by
  rw [Perm.coe_pow]

omit [Fintype D] [DecidableEq D] in
/-- An iterate strictly inside the minimal period does not return. -/
theorem perm_pow_ne_self_of_lt (π : Perm D) {a : D} {i : ℕ} (hi0 : 0 < i)
    (hi : i < Function.minimalPeriod π a) : (π ^ i) a ≠ a := by
  intro h
  rw [perm_pow_eq_iterate] at h
  exact absurd (Function.IsPeriodicPt.minimalPeriod_le hi0 h) (not_le.mpr hi)

omit [Fintype D] [DecidableEq D] in
theorem perm_pow_injOn (π : Perm D) {a : D} {i j : ℕ} (hi : i < Function.minimalPeriod π a)
    (hj : j < Function.minimalPeriod π a) (h : (π ^ i) a = (π ^ j) a) : i = j := by
  rw [perm_pow_eq_iterate, perm_pow_eq_iterate] at h
  exact Function.iterate_injOn_Iio_minimalPeriod hi hj h

omit [Fintype D] [DecidableEq D] in
theorem perm_pow_minimalPeriod (π : Perm D) (a : D) :
    (π ^ Function.minimalPeriod π a) a = a := by
  rw [perm_pow_eq_iterate]
  exact Function.iterate_minimalPeriod

omit [Fintype D] [DecidableEq D] in
theorem perm_pow_mod_minimalPeriod (π : Perm D) (a : D) (n : ℕ) :
    (π ^ (n % Function.minimalPeriod π a)) a = (π ^ n) a := by
  rw [perm_pow_eq_iterate, perm_pow_eq_iterate]
  exact Function.iterate_mod_minimalPeriod_eq

omit [Fintype D] in
/-- Walking from `x` with `π * (x y)` traverses the cycle of `y` under `π`, provided `x` is not on
that cycle. -/
theorem mul_swap_pow_apply_left {π : Perm D} {x y : D} (hxy : ¬ π.SameCycle y x) :
    ∀ i, 1 ≤ i → i ≤ Function.minimalPeriod π y →
      ((π * swap x y) ^ i) x = (π ^ i) y := by
  intro i hi1 hip
  induction i with
  | zero => omega
  | succ i ih =>
      rcases Nat.eq_zero_or_pos i with rfl | hi
      · simp [swap_apply_left]
      · rw [pow_succ', Perm.mul_apply, ih hi (by omega), pow_succ', Perm.mul_apply,
          Perm.mul_apply]
        congr 1
        apply swap_apply_of_ne_of_ne
        · intro h
          exact hxy ⟨i, by rw [zpow_natCast, h]⟩
        · exact perm_pow_ne_self_of_lt π hi (by omega)

omit [Fintype D] in
/-- If `x` is not on the cycle of `y`, then `π * (x y)` relates `x` to the whole cycle of `y`. -/
theorem sameCycle_mul_swap_of_sameCycle [Finite D] {π : Perm D} {x y u : D}
    (hxy : ¬ π.SameCycle y x) (hu : π.SameCycle y u) : (π * swap x y).SameCycle x u := by
  obtain ⟨n, rfl⟩ := sameCycle_iff_exists_nat.mp hu
  set p := Function.minimalPeriod π y with hp
  have hp0 : 0 < p := minimalPeriod_perm_pos π y
  rw [← perm_pow_mod_minimalPeriod]
  rcases Nat.eq_zero_or_pos (n % p) with h0 | hpos
  · rw [h0, pow_zero, Perm.one_apply]
    exact sameCycle_iff_exists_nat.mpr
      ⟨p, by rw [mul_swap_pow_apply_left hxy p hp0 le_rfl, hp, perm_pow_minimalPeriod]⟩
  · exact sameCycle_iff_exists_nat.mpr
      ⟨n % p, mul_swap_pow_apply_left hxy _ hpos (Nat.mod_lt _ hp0).le⟩

omit [Fintype D] in
/-- **Joining two cycles.**  If `x` and `y` lie on different cycles of `π`, then the cycles of
`π * (x y)` are those of `π`, except that the two cycles of `x` and `y` are joined. -/
theorem sameCycle_mul_swap_iff [Finite D] {π : Perm D} {x y : D} (hxy : ¬ π.SameCycle x y)
    (z w : D) :
    (π * swap x y).SameCycle z w ↔ π.SameCycle z w ∨
      ((π.SameCycle z x ∨ π.SameCycle z y) ∧ (π.SameCycle w x ∨ π.SameCycle w y)) := by
  set ρ := π * swap x y with hρ
  set Q : D → Prop := fun u => π.SameCycle u x ∨ π.SameCycle u y with hQ
  have hQπ : ∀ u, Q (π u) ↔ Q u := by
    intro u
    simp only [hQ, Perm.sameCycle_apply_left]
  have hQρ : ∀ u, Q u → Q (ρ u) := by
    intro u hu
    rw [hρ, Perm.mul_apply, hQπ]
    rcases eq_or_ne u x with rfl | hux
    · rw [swap_apply_left]; exact Or.inr (Perm.SameCycle.refl _ _)
    rcases eq_or_ne u y with rfl | huy
    · rw [swap_apply_right]; exact Or.inl (Perm.SameCycle.refl _ _)
    rw [swap_apply_of_ne_of_ne hux huy]; exact hu
  have hyx : ¬ π.SameCycle y x := fun h => hxy h.symm
  -- on `Q`, everything is `ρ`-related to `x`
  have hρx : ∀ u, Q u → ρ.SameCycle x u := by
    have hxy' : ρ.SameCycle x y := sameCycle_mul_swap_of_sameCycle hyx (Perm.SameCycle.refl _ _)
    intro u hu
    rcases hu with hu | hu
    · have h1 : (π * swap y x).SameCycle y u := sameCycle_mul_swap_of_sameCycle hxy hu.symm
      rw [swap_comm] at h1
      exact hxy'.trans h1
    · exact sameCycle_mul_swap_of_sameCycle hyx hu.symm
  constructor
  · intro h
    by_cases hz : Q z
    · exact Or.inr ⟨hz, sameCycle_of_invariant Q hQρ h hz⟩
    · left
      refine sameCycle_of_invariant (fun u => π.SameCycle z u) ?_ h (Perm.SameCycle.refl _ _)
      intro u hu
      have hux : u ≠ x := fun h => hz (Or.inl (h ▸ hu))
      have huy : u ≠ y := fun h => hz (Or.inr (h ▸ hu))
      change π.SameCycle z ((π * swap x y) u)
      rw [Perm.mul_apply, swap_apply_of_ne_of_ne hux huy, Perm.sameCycle_apply_right]
      exact hu
  · rintro (h | ⟨hz, hw⟩)
    · by_cases hz : Q z
      · have hw : Q w := by
          rcases hz with hz | hz
          · exact Or.inl (h.symm.trans hz)
          · exact Or.inr (h.symm.trans hz)
        exact (hρx z hz).symm.trans (hρx w hw)
      · -- off `Q`, the two permutations agree along the cycle of `z`
        have hagree : ∀ n : ℕ, (ρ ^ n) z = (π ^ n) z := by
          intro n
          induction n with
          | zero => rfl
          | succ n ih =>
              have hQn : ¬ Q ((π ^ n) z) := by
                intro hq
                apply hz
                rcases hq with hq | hq
                · exact Or.inl ((Perm.sameCycle_pow_left).mp hq)
                · exact Or.inr ((Perm.sameCycle_pow_left).mp hq)
              have hux : (π ^ n) z ≠ x := fun h => hQn (Or.inl (h ▸ Perm.SameCycle.refl _ _))
              have huy : (π ^ n) z ≠ y := fun h => hQn (Or.inr (h ▸ Perm.SameCycle.refl _ _))
              rw [pow_succ', Perm.mul_apply, ih, hρ, Perm.mul_apply, swap_apply_of_ne_of_ne hux huy,
                pow_succ', Perm.mul_apply]
        obtain ⟨n, rfl⟩ := sameCycle_iff_exists_nat.mp h
        exact sameCycle_iff_exists_nat.mpr ⟨n, hagree n⟩
    · exact (hρx z hz).symm.trans (hρx w hw)

omit [Fintype D] in
/-- **Cutting a cycle.**  If `x ≠ y` lie on the same cycle of `π`, they lie on different cycles of
`π * (x y)`. -/
theorem not_sameCycle_mul_swap [Finite D] {π : Perm D} {x y : D} (hne : x ≠ y)
    (hxy : π.SameCycle x y) :
    ¬ (π * swap x y).SameCycle x y := by
  set p := Function.minimalPeriod π x with hp
  have hp0 : 0 < p := minimalPeriod_perm_pos π x
  obtain ⟨n, hn⟩ := sameCycle_iff_exists_nat.mp hxy
  set j := n % p with hj
  have hjy : (π ^ j) x = y := by rw [hj, hp, perm_pow_mod_minimalPeriod, hn]
  have hjp : j < p := Nat.mod_lt _ hp0
  have hj0 : 0 < j := by
    rcases Nat.eq_zero_or_pos j with h | h
    · exact absurd (by rw [← hjy, h, pow_zero, Perm.one_apply]) hne
    · exact h
  -- the invariant arc `x, π^(j+1) x, …, π^(p-1) x`
  set P : D → Prop := fun u => u = x ∨ ∃ i, j < i ∧ i < p ∧ u = (π ^ i) x with hP
  have hstep : ∀ i, j < i → i ≤ p → P ((π ^ i) x) := by
    intro i hi hip
    rcases lt_or_eq_of_le hip with h | rfl
    · exact Or.inr ⟨i, hi, h, rfl⟩
    · exact Or.inl (perm_pow_minimalPeriod π x)
  have hinv : ∀ u, P u → P ((π * swap x y) u) := by
    rintro u (rfl | ⟨i, hji, hip, rfl⟩)
    · rw [Perm.mul_apply, swap_apply_left, ← hjy, ← Perm.mul_apply, ← pow_succ']
      exact hstep (j + 1) (by omega) (by omega)
    · have hux : (π ^ i) x ≠ x := perm_pow_ne_self_of_lt π (by omega) hip
      have huy : (π ^ i) x ≠ y := by
        intro h
        rw [← hjy] at h
        exact absurd (perm_pow_injOn π hip hjp h) (by omega)
      rw [Perm.mul_apply, swap_apply_of_ne_of_ne hux huy, ← Perm.mul_apply, ← pow_succ']
      exact hstep (i + 1) (by omega) (by omega)
  intro h
  rcases sameCycle_of_invariant P hinv h (Or.inl rfl) with h' | ⟨i, hji, hip, h'⟩
  · exact hne h'.symm
  · rw [← hjy] at h'
    exact absurd (perm_pow_injOn π hjp hip h') (by omega)

/-- Joining two cycles lowers the number of cycles by one. -/
theorem numOrbits_mul_swap_of_not_sameCycle {π : Perm D} {x y : D} (hxy : ¬ π.SameCycle x y) :
    numOrbits (π * swap x y) + 1 = numOrbits π := by
  rw [numOrbits_eq_numClasses, numOrbits_eq_numClasses]
  exact numClasses_merge _ _ (Perm.SameCycle.setoid π).iseqv hxy (sameCycle_mul_swap_iff hxy)

/-- Cutting a cycle raises the number of cycles by one. -/
theorem numOrbits_mul_swap_of_sameCycle {π : Perm D} {x y : D} (hne : x ≠ y)
    (hxy : π.SameCycle x y) : numOrbits (π * swap x y) = numOrbits π + 1 := by
  have h := numOrbits_mul_swap_of_not_sameCycle (not_sameCycle_mul_swap hne hxy)
  rw [mul_assoc, swap_mul_self, mul_one] at h
  exact h.symm

end Orbits

/-! ### Products of transpositions -/

section Transpositions

variable {D : Type*} [Fintype D] [DecidableEq D]

/-- The product `(x₁ y₁) (x₂ y₂) ⋯ (x_k y_k)` of the transpositions of a list of pairs. -/
def swapProd (L : List (D × D)) : Perm D := (L.map fun p => swap p.1 p.2).prod

omit [Fintype D] in
@[simp] theorem swapProd_nil : swapProd ([] : List (D × D)) = 1 := rfl

omit [Fintype D] in
@[simp] theorem swapProd_cons (p : D × D) (L : List (D × D)) :
    swapProd (p :: L) = swap p.1 p.2 * swapProd L := rfl

/-- The equivalence relation generated by the steps `a ↦ σ a` and by the pairs of `L`: its
classes are the orbits of the group generated by `σ` and the transpositions of `L`. -/
def stepComp (σ : Perm D) (L : List (D × D)) : D → D → Prop :=
  Relation.EqvGen fun a b => b = σ a ∨ (a, b) ∈ L

/-- The number of classes of `stepComp σ L`. -/
noncomputable def compClasses (σ : Perm D) (L : List (D × D)) : ℕ :=
  @numClasses D _ _ (stepComp σ L) (Classical.decRel _)

omit [Fintype D] [DecidableEq D] in
theorem sameCycle_iff_eqvGen [Finite D] (σ : Perm D) (a b : D) :
    σ.SameCycle a b ↔ Relation.EqvGen (fun a b => b = σ a) a b := by
  constructor
  · intro h
    obtain ⟨n, rfl⟩ := sameCycle_iff_exists_nat.mp h
    clear h
    induction n with
    | zero => simpa using Relation.EqvGen.refl a
    | succ n ih =>
        rw [pow_succ', Perm.mul_apply]
        exact Relation.EqvGen.trans _ _ _ ih (Relation.EqvGen.rel _ _ rfl)
  · intro h
    induction h with
    | rel x y hxy => exact ⟨1, by rw [hxy, zpow_one]⟩
    | refl x => exact Perm.SameCycle.refl _ _
    | symm x y _ ih => exact ih.symm
    | trans x y z _ _ ih1 ih2 => exact ih1.trans ih2

omit [Fintype D] [DecidableEq D] in
theorem stepComp_of_sameCycle [Finite D] {σ : Perm D} (L : List (D × D)) {a b : D}
    (h : σ.SameCycle a b) :
    stepComp σ L a b :=
  eqvGen_of_le (fun _ _ hab => Relation.EqvGen.rel _ _ (Or.inl hab))
    ((sameCycle_iff_eqvGen σ a b).mp h)

omit [Fintype D] [DecidableEq D] in
theorem stepComp_nil_iff [Finite D] (σ : Perm D) (a b : D) :
    stepComp σ [] a b ↔ σ.SameCycle a b := by
  rw [sameCycle_iff_eqvGen]
  unfold stepComp
  constructor
  · exact eqvGen_of_le fun _ _ hab => Relation.EqvGen.rel _ _ (by simpa using hab)
  · exact eqvGen_of_le fun a b hab => Relation.EqvGen.rel _ _ (Or.inl hab)

omit [Fintype D] in
/-- In the generated relation, `z` is related to `(x y) z` as soon as the pair `(x, y)` is
available. -/
theorem eqvGen_swap {R : D → D → Prop} {x y : D} (hxy : R x y) (z : D) :
    Relation.EqvGen R z (swap x y z) := by
  rcases eq_or_ne z x with rfl | hzx
  · rw [swap_apply_left]; exact Relation.EqvGen.rel _ _ hxy
  rcases eq_or_ne z y with rfl | hzy
  · rw [swap_apply_right]; exact Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ hxy)
  rw [swap_apply_of_ne_of_ne hzx hzy]; exact Relation.EqvGen.refl _

omit [Fintype D] in
/-- Peeling off the first pair: the components of `σ` and `(x, y) :: L` are those of
`σ * (x y)` and `L`, with the classes of `x` and `y` merged. -/
theorem stepComp_cons_iff (σ : Perm D) (x y : D) (L : List (D × D)) (z w : D) :
    stepComp σ ((x, y) :: L) z w ↔
      Relation.EqvGen (fun a b => (b = (σ * swap x y) a ∨ (a, b) ∈ L) ∨ (a = x ∧ b = y)) z w := by
  unfold stepComp
  constructor
  · apply eqvGen_of_le
    rintro a b (rfl | hab)
    · -- `a ~ (x y) a ↦ σ ((x y) a) = σ a`
      refine Relation.EqvGen.trans _ (swap x y a) _
        (eqvGen_swap (R := fun a b => (b = (σ * swap x y) a ∨ (a, b) ∈ L) ∨ (a = x ∧ b = y))
          (Or.inr ⟨rfl, rfl⟩) a) ?_
      refine Relation.EqvGen.rel _ _ (Or.inl (Or.inl ?_))
      rw [Perm.mul_apply, swap_apply_self]
    · rcases List.mem_cons.mp hab with h | h
      · obtain ⟨rfl, rfl⟩ := Prod.mk.inj h
        exact Relation.EqvGen.rel _ _ (Or.inr ⟨rfl, rfl⟩)
      · exact Relation.EqvGen.rel _ _ (Or.inl (Or.inr h))
  · apply eqvGen_of_le
    rintro a b ((rfl | hab) | ⟨rfl, rfl⟩)
    · refine Relation.EqvGen.trans _ (swap x y a) _
        (eqvGen_swap (R := fun a b => b = σ a ∨ (a, b) ∈ (x, y) :: L)
          (Or.inr (List.mem_cons_self ..)) a) ?_
      exact Relation.EqvGen.rel _ _ (Or.inl rfl)
    · exact Relation.EqvGen.rel _ _ (Or.inr (List.mem_cons_of_mem _ hab))
    · exact Relation.EqvGen.rel _ _ (Or.inr (List.mem_cons_self ..))

/-- Peeling off one pair loses at most one component, and none if the pair is already joined. -/
theorem compClasses_cons (σ : Perm D) (x y : D) (L : List (D × D)) :
    compClasses (σ * swap x y) L ≤ compClasses σ ((x, y) :: L) + 1 ∧
      (stepComp (σ * swap x y) L x y →
        compClasses σ ((x, y) :: L) = compClasses (σ * swap x y) L) := by
  classical
  set R : D → D → Prop := fun a b => b = (σ * swap x y) a ∨ (a, b) ∈ L with hR
  have he := Relation.EqvGen.is_equivalence R
  have hiff : ∀ z w, stepComp σ ((x, y) :: L) z w ↔
      Relation.EqvGen R z w ∨ ((Relation.EqvGen R z x ∨ Relation.EqvGen R z y) ∧
        (Relation.EqvGen R w x ∨ Relation.EqvGen R w y)) := by
    intro z w
    rw [stepComp_cons_iff]
    exact eqvGen_or_pair_iff
  have hjoined : stepComp (σ * swap x y) L x y →
      compClasses σ ((x, y) :: L) = compClasses (σ * swap x y) L := by
    intro hxy
    unfold compClasses
    apply numClasses_congr
    intro z w
    rw [hiff]
    constructor
    · rintro (h | ⟨h1, h2⟩)
      · exact h
      · have hzx : Relation.EqvGen R z x := by
          rcases h1 with h1 | h1
          · exact h1
          · exact he.trans h1 (he.symm hxy)
        have hwx : Relation.EqvGen R w x := by
          rcases h2 with h2 | h2
          · exact h2
          · exact he.trans h2 (he.symm hxy)
        exact he.trans hzx (he.symm hwx)
    · exact Or.inl
  refine ⟨?_, hjoined⟩
  by_cases hxy : stepComp (σ * swap x y) L x y
  · rw [hjoined hxy]; omega
  · have hm := @numClasses_merge D _ _ (Relation.EqvGen R) (stepComp σ ((x, y) :: L))
      (Classical.decRel _) (Classical.decRel _) he x y hxy hiff
    unfold compClasses
    change numClasses (Relation.EqvGen R) ≤ _
    omega

/-- **The cycle bound.**  Multiplying `σ` by the transpositions of `L` gives a permutation with
`#cyc(σ ∏ τ) + #cyc(σ) ≤ |L| + 2 · #components`, the components being those of the relation
generated by `σ` and the pairs of `L`. -/
theorem numOrbits_mul_swapProd_add_le (L : List (D × D)) :
    ∀ σ : Perm D, numOrbits (σ * swapProd L) + numOrbits σ ≤ L.length + 2 * compClasses σ L := by
  induction L with
  | nil =>
      intro σ
      have : compClasses σ [] = numOrbits σ := by
        unfold compClasses
        rw [numOrbits_eq_numClasses]
        exact @numClasses_congr D _ _ _ _ (Classical.decRel _) _ (stepComp_nil_iff σ)
      simp [this]
      omega
  | cons p L ih =>
      intro σ
      obtain ⟨x, y⟩ := p
      have hmul : σ * swapProd ((x, y) :: L) = σ * swap x y * swapProd L := by
        rw [swapProd_cons, mul_assoc]
      rw [hmul, List.length_cons]
      have hIH := ih (σ * swap x y)
      obtain ⟨hle, hjoin⟩ := compClasses_cons σ x y L
      by_cases hne : x = y
      · subst hne
        have h1 : σ * swap x x = σ := by rw [swap_self]; exact mul_one σ
        rw [h1] at hIH hle hjoin ⊢
        have := hjoin (Relation.EqvGen.refl _)
        omega
      by_cases hxy : σ.SameCycle x y
      · have hc := numOrbits_mul_swap_of_sameCycle hne hxy
        omega
      · have hc := numOrbits_mul_swap_of_not_sameCycle hxy
        have hjoined : stepComp (σ * swap x y) L x y := by
          apply stepComp_of_sameCycle
          rw [sameCycle_mul_swap_iff hxy]
          exact Or.inr ⟨Or.inl (Perm.SameCycle.refl _ _), Or.inr (Perm.SameCycle.refl _ _)⟩
        have := hjoin hjoined
        omega

/-- **The parity.**  Each transposition changes the number of cycles by one. -/
theorem even_numOrbits_mul_swapProd (L : List (D × D)) (hL : ∀ p ∈ L, p.1 ≠ p.2) :
    ∀ σ : Perm D, Even (numOrbits (σ * swapProd L) + numOrbits σ + L.length) := by
  induction L with
  | nil => intro σ; simp
  | cons p L ih =>
      intro σ
      obtain ⟨x, y⟩ := p
      have hne : x ≠ y := hL (x, y) (List.mem_cons_self ..)
      have hIH := ih (fun q hq => hL q (List.mem_cons_of_mem _ hq)) (σ * swap x y)
      rw [swapProd_cons, ← mul_assoc, List.length_cons]
      dsimp only
      rw [Nat.even_iff] at hIH ⊢
      by_cases hxy : σ.SameCycle x y
      · have hc := numOrbits_mul_swap_of_sameCycle hne hxy
        omega
      · have hc := numOrbits_mul_swap_of_not_sameCycle hxy
        omega

end Transpositions

/-! ### Ribbon graphs -/

/-- A **ribbon graph** (combinatorial map) with edge set `E`.  Its darts are the edge-ends
`E × Bool`, the two ends `(e, false)`, `(e, true)` of each edge; the ribbon structure is the
**vertex rotation** `σ`, a permutation of the darts whose cycles are the vertices, each with the
cyclic order of its incident darts.  The edge involution `α` is fixed: it exchanges the two ends of
each edge (`RibbonGraph.edgeInv`). -/
structure RibbonGraph (E : Type*) [Fintype E] [DecidableEq E] where
  /-- The vertex rotation `σ`: the cyclic orders of the darts around the vertices. -/
  rotation : Perm (E × Bool)

namespace RibbonGraph

variable {E : Type*} [Fintype E] [DecidableEq E]

/-- The **edge involution** `α (e, b) = (e, !b)`, exchanging the two ends of every edge. -/
def edgeInv : Perm (E × Bool) where
  toFun d := (d.1, !d.2)
  invFun d := (d.1, !d.2)
  left_inv d := by simp
  right_inv d := by simp

omit [Fintype E] [DecidableEq E] in
@[simp] theorem edgeInv_apply (d : E × Bool) : (edgeInv : Perm (E × Bool)) d = (d.1, !d.2) := rfl

omit [Fintype E] [DecidableEq E] in
/-- `α` is an involution. -/
theorem edgeInv_edgeInv (d : E × Bool) : edgeInv (edgeInv d) = d := by simp

omit [Fintype E] [DecidableEq E] in
/-- `α` has no fixed point. -/
theorem edgeInv_ne (d : E × Bool) : edgeInv d ≠ d := by
  rcases d with ⟨e, b⟩
  cases b <;> simp

variable (M : RibbonGraph E)

/-- The **face permutation** `φ = σ ∘ α`: from a dart, cross its edge, then turn to the next dart
in the cyclic order at the far vertex.  Its cycles are the boundary walks of the faces. -/
def facePerm : Perm (E × Bool) := M.rotation * edgeInv

theorem facePerm_apply (d : E × Bool) : M.facePerm d = M.rotation (d.1, !d.2) := rfl

/-- The vertices, as the sets of darts of the cycles of `σ`. -/
def vertices : Finset (Finset (E × Bool)) := permOrbits M.rotation

/-- The faces, as the sets of darts of the cycles of `φ = σ ∘ α`. -/
def faces : Finset (Finset (E × Bool)) := permOrbits M.facePerm

/-- The number of vertices `#V`, the number of cycles of `σ`. -/
def numVertices : ℕ := numOrbits M.rotation

/-- The number of edges `#E`. -/
def numEdges (_M : RibbonGraph E) : ℕ := Fintype.card E

/-- The number of faces `#F`, the number of cycles of `φ`. -/
def numFaces : ℕ := numOrbits M.facePerm

theorem numVertices_eq_card : M.numVertices = M.vertices.card := rfl

theorem numFaces_eq_card : M.numFaces = M.faces.card := rfl

/-- The **Euler characteristic** `χ = #V - #E + #F`. -/
def eulerChar : ℤ := M.numVertices - M.numEdges + M.numFaces

/-- The **genus** `g = (2 - χ) / 2`.  For a connected ribbon graph `χ` is even and at most `2`
(`even_eulerChar`, `eulerChar_le_two`), so that `χ = 2 - 2g` exactly (`eulerChar_eq`). -/
def genus : ℕ := (M.numEdges + 2 - M.numVertices - M.numFaces) / 2

/-- A ribbon graph is **connected** when the group `⟨σ, α⟩` acts transitively on the darts:
any two darts are related by the equivalence relation generated by the steps `d ↦ σ d` and
`d ↦ α d`. -/
def Connected : Prop :=
  ∀ d d' : E × Bool, Relation.EqvGen (fun a b => b = M.rotation a ∨ b = edgeInv a) d d'

/-! #### The edges are the cycles of `α` -/

omit [Fintype E] [DecidableEq E] in
theorem sameCycle_edgeInv_iff [Finite E] (d d' : E × Bool) :
    (edgeInv : Perm (E × Bool)).SameCycle d d' ↔ d'.1 = d.1 := by
  constructor
  · intro h
    exact sameCycle_of_invariant (fun u : E × Bool => u.1 = d.1) (fun u hu => by simpa using hu)
      h rfl
  · intro h
    rcases d with ⟨e, b⟩
    rcases d' with ⟨e', b'⟩
    simp only at h
    subst h
    by_cases hb : b' = b
    · subst hb; exact Perm.SameCycle.refl _ _
    · refine ⟨1, ?_⟩
      rw [zpow_one, edgeInv_apply]
      cases b <;> cases b' <;> simp_all

/-- The edges are the cycles of `α`: there are exactly `#E` of them. -/
theorem numOrbits_edgeInv : numOrbits (edgeInv : Perm (E × Bool)) = Fintype.card E := by
  unfold numOrbits permOrbits
  have hfib : ∀ d : E × Bool, (univ.filter fun d' => (edgeInv : Perm (E × Bool)).SameCycle d d') =
      univ.filter fun d' : E × Bool => d'.1 = d.1 := by
    intro d
    ext d'
    simp [sameCycle_edgeInv_iff]
  simp_rw [hfib]
  have himage : (univ.image fun d : E × Bool => univ.filter fun d' : E × Bool => d'.1 = d.1) =
      univ.image fun e : E => univ.filter fun d' : E × Bool => d'.1 = e := by
    ext c
    simp only [mem_image, mem_univ, true_and]
    constructor
    · rintro ⟨d, rfl⟩; exact ⟨d.1, rfl⟩
    · rintro ⟨e, rfl⟩; exact ⟨(e, false), rfl⟩
  rw [himage, card_image_of_injective, card_univ]
  intro e e' h
  simp only at h
  have : (e, false) ∈ univ.filter fun d' : E × Bool => d'.1 = e' := by
    rw [← h]; simp
  simpa using this

/-! #### The edge involution as a product of transpositions -/

/-- The list of the pairs `((e, false), (e, true))`, one for every edge. -/
noncomputable def edgePairs : List ((E × Bool) × (E × Bool)) :=
  (univ : Finset E).toList.map fun e => ((e, false), (e, true))

omit [DecidableEq E] in
theorem length_edgePairs :
    (edgePairs : List ((E × Bool) × (E × Bool))).length = Fintype.card E := by
  simp [edgePairs]

omit [DecidableEq E] in
theorem edgePairs_ne : ∀ p ∈ (edgePairs : List ((E × Bool) × (E × Bool))), p.1 ≠ p.2 := by
  intro p hp
  obtain ⟨e, -, rfl⟩ := List.mem_map.mp hp
  simp

omit [Fintype E] in
private theorem prod_swap_apply (l : List E) (hl : l.Nodup) (d : E × Bool) :
    (l.map fun e => swap (e, false) (e, true)).prod d = if d.1 ∈ l then (d.1, !d.2) else d := by
  induction l with
  | nil => simp
  | cons e l ih =>
      rw [List.nodup_cons] at hl
      rw [List.map_cons, List.prod_cons, Perm.mul_apply, ih hl.2]
      rcases d with ⟨e', b⟩
      by_cases he : e' = e
      · subst he
        simp only [hl.1, if_false, List.mem_cons, true_or, if_true]
        cases b <;> simp
      · have hne1 : ∀ c, (e', c) ≠ (e, false) := fun c h => he (Prod.mk.inj h).1
        have hne2 : ∀ c, (e', c) ≠ (e, true) := fun c h => he (Prod.mk.inj h).1
        simp only [List.mem_cons, he, false_or]
        split_ifs
        · exact swap_apply_of_ne_of_ne (hne1 _) (hne2 _)
        · exact swap_apply_of_ne_of_ne (hne1 _) (hne2 _)

/-- `α` is the product of the `#E` transpositions `(e, false) ↔ (e, true)`. -/
theorem edgeInv_eq_swapProd : (edgeInv : Perm (E × Bool)) = swapProd edgePairs := by
  ext1 d
  unfold swapProd edgePairs
  rw [List.map_map]
  change _ = ((univ : Finset E).toList.map fun e => swap (e, false) (e, true)).prod d
  rw [prod_swap_apply _ (nodup_toList _)]
  simp

/-- For a connected ribbon graph, `σ` and the pairs of edge-ends generate a single component. -/
theorem stepComp_edgePairs_of_connected (hM : M.Connected) (d d' : E × Bool) :
    stepComp M.rotation edgePairs d d' := by
  refine eqvGen_of_le ?_ (hM d d')
  rintro a b (rfl | rfl)
  · exact Relation.EqvGen.rel _ _ (Or.inl rfl)
  · rcases a with ⟨e, c⟩
    have hmem : ((e, false), (e, true)) ∈ (edgePairs : List ((E × Bool) × (E × Bool))) :=
      List.mem_map.mpr ⟨e, mem_toList.mpr (mem_univ e), rfl⟩
    cases c
    · exact Relation.EqvGen.rel _ _ (Or.inr hmem)
    · exact Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ (Or.inr hmem))

/-! #### Euler's formula -/

/-- **The Euler characteristic is even** (for every ribbon graph). -/
theorem even_eulerChar : Even M.eulerChar := by
  have h := even_numOrbits_mul_swapProd edgePairs edgePairs_ne M.rotation
  rw [← edgeInv_eq_swapProd, length_edgePairs] at h
  obtain ⟨k, hk⟩ := h
  refine ⟨(k : ℤ) - M.numEdges, ?_⟩
  have hk' : ((numOrbits M.facePerm + numOrbits M.rotation + Fintype.card E : ℕ) : ℤ) = k + k := by
    exact_mod_cast hk
  unfold eulerChar numVertices numEdges numFaces
  push_cast at hk' ⊢
  linarith

/-- **The Euler characteristic of a connected ribbon graph is at most `2`.** -/
theorem eulerChar_le_two (hM : M.Connected) : M.eulerChar ≤ 2 := by
  have h := numOrbits_mul_swapProd_add_le edgePairs M.rotation
  rw [← edgeInv_eq_swapProd, length_edgePairs] at h
  have hK : compClasses M.rotation edgePairs ≤ 1 := by
    unfold compClasses
    exact @numClasses_le_one_of_forall _ _ _ _ (Classical.decRel _)
      (M.stepComp_edgePairs_of_connected hM)
  have h' : numOrbits M.facePerm + numOrbits M.rotation ≤ Fintype.card E + 2 := by
    change numOrbits (M.rotation * edgeInv) + _ ≤ _
    omega
  unfold eulerChar numVertices numEdges numFaces
  have : ((numOrbits M.facePerm + numOrbits M.rotation : ℕ) : ℤ) ≤ (Fintype.card E + 2 : ℕ) := by
    exact_mod_cast h'
  push_cast at this
  linarith

/-- **Euler's formula `χ = 2 - 2g`** for a connected ribbon graph. -/
theorem eulerChar_eq (hM : M.Connected) : M.eulerChar = 2 - 2 * (M.genus : ℤ) := by
  have hle := M.eulerChar_le_two hM
  obtain ⟨k, hk⟩ := M.even_eulerChar
  unfold eulerChar at hle hk ⊢
  unfold genus
  omega

/-- **Proposition XI.1, the count of faces**: `#F = 2 - 2g - #V + #E` for a connected ribbon
graph. -/
theorem numFaces_eq (hM : M.Connected) :
    (M.numFaces : ℤ) = 2 - 2 * (M.genus : ℤ) - M.numVertices + M.numEdges := by
  have h := M.eulerChar_eq hM
  unfold eulerChar at h
  linarith

end RibbonGraph

end HamiltonianMetricGraphs
