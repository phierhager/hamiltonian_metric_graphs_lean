import HamiltonianMetricGraphs.QuotientPhaseSpace
import HamiltonianMetricGraphs.Reversibility

/-!
# Momentum reversal on the scattering quotient

Under the paper's reversible-scattering condition, componentwise momentum reversal respects the
generated endpoint identifications and therefore descends to the quotient phase space.
-/

namespace HamiltonianMetricGraphs

namespace MechanicalPotential

variable {Γ : FiniteMetricGraph} (V : MechanicalPotential Γ)
variable (S : BorelEnergyPreservingScattering V)

/-- Reversing a scattering step produces a scattering step with the direction reversed. -/
theorem prequotientMomentumReversal_scatteringStep
    (hS : S.toEnergyPreservingScattering.IsReversible)
    {x y : Γ.NonzeroPrequotientPhase}
    (hxy : scatteringStep (V := V) S x y) :
    scatteringStep (V := V) S (Γ.prequotientMomentumReversal y)
      (Γ.prequotientMomentumReversal x) := by
  rcases hxy with ⟨v, α, rfl, rfl⟩
  let β : Γ.OutgoingBoundary v := S.map v α
  let γ : Γ.IncomingBoundary v := (Γ.incomingMomentumReversal v).symm β
  refine ⟨v, γ, ?_, ?_⟩
  · change Γ.prequotientMomentumReversal (β.1.toNonzeroPrequotientPhase Γ) =
      γ.1.toNonzeroPrequotientPhase Γ
    rw [Γ.prequotientMomentumReversal_boundary]
    apply congrArg (fun δ : Γ.BoundaryCovector => δ.toNonzeroPrequotientPhase Γ)
    apply FiniteMetricGraph.BoundaryCovector.ext <;> rfl
  · rw [Γ.prequotientMomentumReversal_boundary]
    apply congrArg (fun δ : Γ.BoundaryCovector => δ.toNonzeroPrequotientPhase Γ)
    have h := congrArg (fun e : Γ.OutgoingBoundary v ≃ Γ.IncomingBoundary v => e β) (hS v)
    change (S.map v).symm β = _ at h
    have h' := congrArg (fun z : Γ.IncomingBoundary v => Γ.incomingMomentumReversal v z) h
    have hout : Γ.incomingMomentumReversal v ((S.map v).symm β) = S.map v γ := by
      simpa [β, γ, Equiv.trans_apply,
        BorelEnergyPreservingScattering.toEnergyPreservingScattering] using h'
    have halpha : (S.map v).symm β = α := by simp [β]
    rw [halpha] at hout
    change (Γ.incomingMomentumReversal v α).1 = (S.map v γ).1
    exact congrArg Subtype.val hout

/-- Prequotient momentum reversal respects the equivalence relation generated by scattering. -/
theorem prequotientMomentumReversal_respects
    (hS : S.toEnergyPreservingScattering.IsReversible)
    {x y : Γ.NonzeroPrequotientPhase}
    (hxy : (scatteringSetoid (V := V) S) x y) :
    (scatteringSetoid (V := V) S) (Γ.prequotientMomentumReversal x)
      (Γ.prequotientMomentumReversal y) := by
  induction hxy with
  | rel x y hxy =>
      exact Relation.EqvGen.symm _ _
        (Relation.EqvGen.rel _ _ (prequotientMomentumReversal_scatteringStep V S hS hxy))
  | refl x => exact Relation.EqvGen.refl _
  | symm x y _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans x y z _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

/-- Momentum reversal descended to the scattering quotient. -/
noncomputable def quotientMomentumReversal
    (hS : S.toEnergyPreservingScattering.IsReversible) :
    ScatteringPhaseSpace (V := V) S → ScatteringPhaseSpace (V := V) S :=
  Quotient.lift (fun x => quotientMap (V := V) S (Γ.prequotientMomentumReversal x))
    (fun _ _ hxy => Quotient.sound (prequotientMomentumReversal_respects V S hS hxy))

@[simp] theorem quotientMomentumReversal_mk
    (hS : S.toEnergyPreservingScattering.IsReversible) (x : Γ.NonzeroPrequotientPhase) :
    quotientMomentumReversal V S hS (quotientMap (V := V) S x) =
      quotientMap (V := V) S (Γ.prequotientMomentumReversal x) := rfl

/-- The descended quotient reversal is measurable for the coinduced quotient Borel structure. -/
theorem measurable_quotientMomentumReversal
    (hS : S.toEnergyPreservingScattering.IsReversible) :
    Measurable (quotientMomentumReversal V S hS) := by
  intro A hA
  rw [measurableSet_quotient_iff] at hA ⊢
  have hpreimage :
      (quotientMap (V := V) S) ⁻¹' (quotientMomentumReversal V S hS ⁻¹' A) =
        Γ.prequotientMomentumReversal ⁻¹' ((quotientMap (V := V) S) ⁻¹' A) := by
    ext x
    rfl
  rw [hpreimage]
  exact hA.preimage Γ.measurable_prequotientMomentumReversal

@[simp] theorem quotientMomentumReversal_involutive
    (hS : S.toEnergyPreservingScattering.IsReversible)
    (z : ScatteringPhaseSpace (V := V) S) :
    quotientMomentumReversal V S hS (quotientMomentumReversal V S hS z) = z := by
  refine Quotient.inductionOn' z ?_
  intro x
  change quotientMomentumReversal V S hS
      (quotientMomentumReversal V S hS (quotientMap (V := V) S x)) =
    quotientMap (V := V) S x
  rw [quotientMomentumReversal_mk, quotientMomentumReversal_mk]
  simp

/-- The descended reversal preserves the quotient Hamiltonian. -/
theorem quotientMomentumReversal_preserves_energy
    (hS : S.toEnergyPreservingScattering.IsReversible)
    (z : ScatteringPhaseSpace (V := V) S) :
    quotientHamiltonian (V := V) S (quotientMomentumReversal V S hS z) =
      quotientHamiltonian (V := V) S z := by
  refine Quotient.inductionOn' z ?_
  intro x
  change quotientHamiltonian (V := V) S
      (quotientMomentumReversal V S hS (quotientMap (V := V) S x)) =
    quotientHamiltonian (V := V) S (quotientMap (V := V) S x)
  rw [quotientMomentumReversal_mk, quotientHamiltonian_mk, quotientHamiltonian_mk]
  exact V.prequotientHamiltonian_momentumReversal x

/-- Quotient momentum reversal restricts to the regular energy sector. -/
noncomputable def regularQuotientMomentumReversal
    (hS : S.toEnergyPreservingScattering.IsReversible) :
    RegularScatteringPhaseSpace (V := V) S → RegularScatteringPhaseSpace (V := V) S :=
  fun z => ⟨quotientMomentumReversal V S hS z.1, by
    change quotientHamiltonian (V := V) S
      (quotientMomentumReversal V S hS z.1) ∉ V.exceptionalEnergies
    rw [quotientMomentumReversal_preserves_energy V S hS]
    exact z.2⟩

/-- Quotient momentum reversal is measurable after restriction to the regular sector. -/
theorem measurable_regularQuotientMomentumReversal
    (hS : S.toEnergyPreservingScattering.IsReversible) :
    Measurable (regularQuotientMomentumReversal V S hS) := by
  rw [measurable_comap_iff]
  change Measurable (fun z : RegularScatteringPhaseSpace (V := V) S =>
    quotientMomentumReversal V S hS z.1)
  exact (measurable_quotientMomentumReversal V S hS).comp measurable_subtype_coe

@[simp] theorem regularQuotientMomentumReversal_involutive
    (hS : S.toEnergyPreservingScattering.IsReversible)
    (z : RegularScatteringPhaseSpace (V := V) S) :
    regularQuotientMomentumReversal V S hS
      (regularQuotientMomentumReversal V S hS z) = z := by
  apply Subtype.ext
  exact quotientMomentumReversal_involutive V S hS z.1

end MechanicalPotential
end HamiltonianMetricGraphs
