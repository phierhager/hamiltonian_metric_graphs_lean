import HamiltonianMetricGraphs.Realization.HybridChain

/-!
# Free graph trajectories on a unit-length metric graph

For the explicit microscopic realization we use the zero graph potential `V ≡ 0` on a graph all of
whose edges have length `1`.  The graph dynamics is then free motion at constant speed `c`, and the
whole scattering trajectory is completely explicit: the itinerary of impact germs is generated by
the routing law, every flight after the first traverses one full edge in time `1/c`, and the
momentum is `σ(η_j) c` while the flight approaches the germ `η_j`.

This file constructs that trajectory as a genuine `GraphTrajectory`, i.e. it discharges every
field of `HybridChain` at `ChainParams.zero`.  Nothing is assumed: Hamilton's equations hold
exactly because the force of the zero potential vanishes.

Mathematical proof step: the deterministic graph-scattering trajectory whose microscopic
realization is the goal of the explicit branching model.
-/

namespace HamiltonianMetricGraphs

open Set FiniteMetricGraph

/-! ### The zero potential -/

/-- The identically zero mechanical potential on a finite metric graph. -/
def zeroPotential (Γ : FiniteMetricGraph) : MechanicalPotential Γ where
  extension _ _ := 0
  domain _ := univ
  domain_isOpen _ := isOpen_univ
  closedEdge_subset_domain _ := subset_univ _
  contDiffOn_extension _ := contDiffOn_const
  vertexValue _ := 0
  endpoint_compatible _ := rfl

variable {Γ : FiniteMetricGraph}

@[simp] theorem zeroPotential_extension (e : Γ.Edge) (q : ℝ) :
    (zeroPotential Γ).extension e q = 0 := rfl

@[simp] theorem zeroPotential_vertexValue (v : Γ.Vertex) :
    (zeroPotential Γ).vertexValue v = 0 := rfl

@[simp] theorem zeroPotential_force (e : Γ.Edge) (q : ℝ) :
    (zeroPotential Γ).force e q = 0 := by
  have h : (zeroPotential Γ).extension e = fun _ : ℝ => (0 : ℝ) := rfl
  simp [MechanicalPotential.force, h]

@[simp] theorem zeroPotential_edgeVectorField (e : Γ.Edge) (x : ℝ × ℝ) :
    (zeroPotential Γ).edgeVectorField e x = (x.2, 0) := by
  simp [MechanicalPotential.edgeVectorField]

@[simp] theorem zeroPotential_hamiltonian (e : Γ.Edge) (q p : ℝ) :
    (zeroPotential Γ).hamiltonian e q p = p ^ 2 / 2 := by
  simp [MechanicalPotential.hamiltonian]

/-- For the zero potential the only exceptional energy is `0`. -/
theorem zeroPotential_not_mem_exceptionalEnergies {E : ℝ} (hE : E ≠ 0) :
    E ∉ (zeroPotential Γ).exceptionalEnergies := by
  intro h
  obtain ⟨v, hv⟩ := (MechanicalPotential.mem_exceptionalEnergies_iff _).mp h
  exact hE (by simpa using hv.symm)

/-! ### Endpoint germ arithmetic -/

theorem sign_eq_ite (η : Γ.EdgeEnd) : EdgeEnd.sign Γ η = if η.2 then 1 else -1 := rfl

theorem sign_of_true {η : Γ.EdgeEnd} (h : η.2 = true) : EdgeEnd.sign Γ η = 1 := by
  rw [sign_eq_ite, h, if_pos rfl]

theorem sign_of_false {η : Γ.EdgeEnd} (h : η.2 = false) : EdgeEnd.sign Γ η = -1 := by
  rw [sign_eq_ite, h]
  rfl

theorem coordinate_of_true (hlen : ∀ e : Γ.Edge, Γ.length e = 1) {η : Γ.EdgeEnd}
    (h : η.2 = true) : EdgeEnd.coordinate Γ η = 1 := by
  change (if η.2 then Γ.length η.1 else 0) = 1
  rw [h, if_pos rfl, hlen]

theorem coordinate_of_false {η : Γ.EdgeEnd} (h : η.2 = false) :
    EdgeEnd.coordinate Γ η = 0 := by
  change (if η.2 then Γ.length η.1 else 0) = 0
  rw [h]
  rfl

/-- The other endpoint germ of the same edge. -/
def otherEnd (η : Γ.EdgeEnd) : Γ.EdgeEnd := (η.1, !η.2)

@[simp] theorem otherEnd_fst (η : Γ.EdgeEnd) : (otherEnd η).1 = η.1 := rfl

@[simp] theorem otherEnd_snd (η : Γ.EdgeEnd) : (otherEnd η).2 = !η.2 := rfl

@[simp] theorem otherEnd_otherEnd (η : Γ.EdgeEnd) : otherEnd (otherEnd η) = η := by
  simp [otherEnd]

theorem sign_otherEnd (η : Γ.EdgeEnd) :
    EdgeEnd.sign Γ (otherEnd η) = -EdgeEnd.sign Γ η := by
  rcases hb : η.2 with _ | _
  · rw [sign_of_false hb, sign_of_true (by simp [hb])]
    norm_num
  · rw [sign_of_true hb, sign_of_false (by simp [hb])]

theorem coordinate_otherEnd_of_length_one (hlen : ∀ e : Γ.Edge, Γ.length e = 1)
    (η : Γ.EdgeEnd) :
    EdgeEnd.coordinate Γ (otherEnd η) = 1 - EdgeEnd.coordinate Γ η := by
  rcases hb : η.2 with _ | _
  · rw [coordinate_of_false hb, coordinate_of_true hlen (by simp [hb])]
    norm_num
  · rw [coordinate_of_true hlen hb, coordinate_of_false (by simp [hb])]
    norm_num

namespace RoutingLaw

/-- The itinerary of impact germs generated by the routing law from a first germ `η₀`: after
entering the router through `η_j` the particle departs along `F(η_j)` and traverses that edge, so
it next arrives at the opposite end of `F(η_j)`. -/
def itinerary (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) : ℕ → Γ.EdgeEnd
  | 0 => η₀
  | j + 1 => otherEnd (F.routeGerm (itinerary F η₀ j))

variable (F : RoutingLaw Γ)

@[simp] theorem itinerary_zero (η₀ : Γ.EdgeEnd) : F.itinerary η₀ 0 = η₀ := rfl

@[simp] theorem itinerary_succ (η₀ : Γ.EdgeEnd) (j : ℕ) :
    F.itinerary η₀ (j + 1) = otherEnd (F.routeGerm (F.itinerary η₀ j)) := rfl

/-- The departure germ of passage `j` is the end opposite to the next arrival germ. -/
theorem routeGerm_itinerary (η₀ : Γ.EdgeEnd) (j : ℕ) :
    F.routeGerm (F.itinerary η₀ j) = otherEnd (F.itinerary η₀ (j + 1)) := by
  rw [itinerary_succ, otherEnd_otherEnd]

end RoutingLaw

/-! ### The free trajectory -/

namespace MechanicalPotential

namespace FreeTrajectory

variable (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) (q₀ c : ℝ) (N : ℕ)

/-- The distance from the initial coordinate to the first impact germ. -/
noncomputable def initialDistance : ℝ := if η₀.2 then 1 - q₀ else q₀

/-- The duration of the first flight. -/
noncomputable def firstDuration : ℝ := initialDistance η₀ q₀ / c

/-- The time needed to traverse one whole (unit-length) edge. -/
noncomputable def crossingTime : ℝ := 1 / c

/-- The start time of flight `j`. -/
noncomputable def startTime (j : ℕ) : ℝ :=
  if j = 0 then 0 else firstDuration η₀ q₀ c + ((j : ℝ) - 1) * crossingTime c

/-- The end time of flight `j`: the impact time for `j < N`, and the end of the time window for
`j = N` (the last flight is stopped halfway across its edge, strictly inside the tube). -/
noncomputable def stopTime (j : ℕ) : ℝ :=
  if j < N then firstDuration η₀ q₀ c + (j : ℝ) * crossingTime c
  else firstDuration η₀ q₀ c + ((N : ℝ) - 1) * crossingTime c + crossingTime c / 2

/-- The coordinate at which flight `j` starts. -/
noncomputable def startCoord : ℕ → ℝ
  | 0 => q₀
  | j + 1 => EdgeEnd.coordinate Γ (F.routeGerm (F.itinerary η₀ j))

/-- The (constant) momentum during flight `j`: the speed `c` oriented towards the germ `η_j`. -/
noncomputable def momentum (j : ℕ) : ℝ := EdgeEnd.sign Γ (F.itinerary η₀ j) * c

/-- The longitudinal state during flight `j`. -/
noncomputable def curve (j : ℕ) (t : ℝ) : ℝ × ℝ :=
  (startCoord F η₀ q₀ j + momentum F η₀ c j * (t - startTime η₀ q₀ c j), momentum F η₀ c j)

variable {F η₀ q₀ c N}

@[simp] theorem curve_snd (j : ℕ) (t : ℝ) :
    (curve F η₀ q₀ c j t).2 = momentum F η₀ c j := rfl

/-- The position along a flight, written with the travelled distance `c (t - start)`. -/
theorem curve_fst (j : ℕ) (t : ℝ) :
    (curve F η₀ q₀ c j t).1 = startCoord F η₀ q₀ j +
      EdgeEnd.sign Γ (F.itinerary η₀ j) * (c * (t - startTime η₀ q₀ c j)) := by
  change startCoord F η₀ q₀ j + momentum F η₀ c j * (t - startTime η₀ q₀ c j) = _
  unfold momentum
  ring

/-! #### Elementary time facts -/

theorem crossingTime_pos (hc : 0 < c) : 0 < crossingTime c := by
  unfold crossingTime; positivity

theorem initialDistance_pos (hq₀ : q₀ ∈ Ioo (0 : ℝ) 1) :
    0 < initialDistance η₀ q₀ := by
  unfold initialDistance
  split <;> linarith [hq₀.1, hq₀.2]

theorem firstDuration_pos (hq₀ : q₀ ∈ Ioo (0 : ℝ) 1) (hc : 0 < c) :
    0 < firstDuration η₀ q₀ c :=
  div_pos (initialDistance_pos hq₀) hc

theorem c_mul_firstDuration (hc : 0 < c) :
    c * firstDuration η₀ q₀ c = initialDistance η₀ q₀ := by
  unfold firstDuration
  field_simp

theorem c_mul_crossingTime (hc : 0 < c) : c * crossingTime c = 1 := by
  unfold crossingTime
  field_simp

theorem startTime_zero : startTime η₀ q₀ c 0 = 0 := by
  unfold startTime; simp

theorem startTime_succ (j : ℕ) :
    startTime η₀ q₀ c (j + 1) = firstDuration η₀ q₀ c + (j : ℝ) * crossingTime c := by
  unfold startTime
  rw [if_neg (Nat.succ_ne_zero j)]
  push_cast
  ring

theorem stopTime_of_lt {j : ℕ} (h : j < N) :
    stopTime η₀ q₀ c N j = firstDuration η₀ q₀ c + (j : ℝ) * crossingTime c := by
  unfold stopTime
  rw [if_pos h]

theorem stopTime_self :
    stopTime η₀ q₀ c N N = firstDuration η₀ q₀ c + ((N : ℝ) - 1) * crossingTime c +
      crossingTime c / 2 := by
  unfold stopTime
  rw [if_neg (lt_irrefl N)]

theorem stopTime_zero (hN : 1 ≤ N) :
    stopTime η₀ q₀ c N 0 = firstDuration η₀ q₀ c := by
  rw [stopTime_of_lt (show 0 < N by omega)]
  norm_num

/-- Every flight after the first lasts at most one edge crossing. -/
theorem duration_succ_le (hc : 0 < c) {j : ℕ} (hj : j + 1 ≤ N) :
    stopTime η₀ q₀ c N (j + 1) - startTime η₀ q₀ c (j + 1) ≤ crossingTime c := by
  rw [startTime_succ]
  rcases lt_or_eq_of_le hj with h | h
  · rw [stopTime_of_lt h]
    push_cast
    linarith
  · rw [← h, stopTime_self]
    push_cast
    have := crossingTime_pos (c := c) hc
    linarith

/-- Every flight after the first has positive duration. -/
theorem duration_succ_pos (hc : 0 < c) {j : ℕ} (hj : j + 1 ≤ N) :
    0 < stopTime η₀ q₀ c N (j + 1) - startTime η₀ q₀ c (j + 1) := by
  rw [startTime_succ]
  have hτ := crossingTime_pos (c := c) hc
  rcases lt_or_eq_of_le hj with h | h
  · rw [stopTime_of_lt h]
    push_cast
    linarith
  · rw [← h, stopTime_self]
    push_cast
    linarith

/-! #### Confinement of a flight to its edge

Each flight travels a distance `u = c (t - start)` from its starting coordinate towards its impact
germ.  The first flight starts at `q₀` and travels at most `initialDistance`; every later flight
starts at the end opposite to its impact germ and travels at most one full edge. -/

/-- The travelled distance along the first flight is at most the initial distance. -/
theorem travel_zero_le (hc : 0 < c) (hN : 1 ≤ N) {t : ℝ}
    (ht : t ≤ stopTime η₀ q₀ c N 0) :
    c * (t - startTime η₀ q₀ c 0) ≤ initialDistance η₀ q₀ := by
  rw [stopTime_zero hN] at ht
  rw [startTime_zero]
  have := c_mul_firstDuration (η₀ := η₀) (q₀ := q₀) hc
  nlinarith

/-- Strict version of `travel_zero_le`. -/
theorem travel_zero_lt (hc : 0 < c) (hN : 1 ≤ N) {t : ℝ}
    (ht : t < stopTime η₀ q₀ c N 0) :
    c * (t - startTime η₀ q₀ c 0) < initialDistance η₀ q₀ := by
  rw [stopTime_zero hN] at ht
  rw [startTime_zero]
  have := c_mul_firstDuration (η₀ := η₀) (q₀ := q₀) hc
  nlinarith

/-- The travelled distance along a later flight is at most one edge. -/
theorem travel_succ_le (hc : 0 < c) {j : ℕ} (hj : j + 1 ≤ N) {t : ℝ}
    (ht : t ≤ stopTime η₀ q₀ c N (j + 1)) :
    c * (t - startTime η₀ q₀ c (j + 1)) ≤ 1 := by
  have hd := duration_succ_le (η₀ := η₀) (q₀ := q₀) (N := N) hc hj
  have hc1 := c_mul_crossingTime (c := c) hc
  nlinarith

/-- Strict version of `travel_succ_le`. -/
theorem travel_succ_lt (hc : 0 < c) {j : ℕ} (hj : j + 1 ≤ N) {t : ℝ}
    (ht : t < stopTime η₀ q₀ c N (j + 1)) :
    c * (t - startTime η₀ q₀ c (j + 1)) < 1 := by
  have hd := duration_succ_le (η₀ := η₀) (q₀ := q₀) (N := N) hc hj
  have hc1 := c_mul_crossingTime (c := c) hc
  nlinarith

/-- Closed form of the starting coordinate of a flight after the first: it is the end opposite to
the germ that flight will reach. -/
theorem startCoord_succ_eq (hlen : ∀ e : Γ.Edge, Γ.length e = 1) (j : ℕ) :
    startCoord F η₀ q₀ (j + 1) = 1 - EdgeEnd.coordinate Γ (F.itinerary η₀ (j + 1)) := by
  change EdgeEnd.coordinate Γ (F.routeGerm (F.itinerary η₀ j)) = _
  rw [F.routeGerm_itinerary, coordinate_otherEnd_of_length_one hlen]

/-- The flight stays on the closed edge. -/
theorem curve_mem_Icc (hlen : ∀ e : Γ.Edge, Γ.length e = 1) (hq₀ : q₀ ∈ Ioo (0 : ℝ) 1)
    (hc : 0 < c) (hN : 1 ≤ N) {j : ℕ} (hj : j ≤ N) {t : ℝ}
    (ht : t ∈ Icc (startTime η₀ q₀ c j) (stopTime η₀ q₀ c N j)) :
    (curve F η₀ q₀ c j t).1 ∈ Icc (0 : ℝ) 1 := by
  have hu0 : 0 ≤ c * (t - startTime η₀ q₀ c j) := mul_nonneg hc.le (by linarith [ht.1])
  rw [curve_fst, mem_Icc]
  rcases j with _ | i
  · have hub := travel_zero_le (η₀ := η₀) (q₀ := q₀) (N := N) hc hN ht.2
    change 0 ≤ q₀ + _ * _ ∧ q₀ + _ * _ ≤ 1
    rcases hb : η₀.2 with _ | _
    · rw [show (RoutingLaw.itinerary F η₀ 0) = η₀ from rfl, sign_of_false hb]
      rw [show initialDistance η₀ q₀ = q₀ by unfold initialDistance; rw [hb]; rfl] at hub
      constructor <;> linarith [hq₀.1, hq₀.2]
    · rw [show (RoutingLaw.itinerary F η₀ 0) = η₀ from rfl, sign_of_true hb]
      rw [show initialDistance η₀ q₀ = 1 - q₀ by
        unfold initialDistance; rw [hb]; rfl] at hub
      constructor <;> linarith [hq₀.1, hq₀.2]
  · have hub := travel_succ_le (η₀ := η₀) (q₀ := q₀) (N := N) hc hj ht.2
    rw [startCoord_succ_eq hlen]
    rcases hb : (F.itinerary η₀ (i + 1)).2 with _ | _
    · rw [sign_of_false hb, coordinate_of_false hb]
      constructor <;> linarith
    · rw [sign_of_true hb, coordinate_of_true hlen hb]
      constructor <;> linarith

/-- Strictly inside the edge before the impact. -/
theorem curve_mem_Ioo (hlen : ∀ e : Γ.Edge, Γ.length e = 1) (hq₀ : q₀ ∈ Ioo (0 : ℝ) 1)
    (hc : 0 < c) (hN : 1 ≤ N) {j : ℕ} (hj : j ≤ N) {t : ℝ}
    (ht : t ∈ Ioo (startTime η₀ q₀ c j) (stopTime η₀ q₀ c N j)) :
    (curve F η₀ q₀ c j t).1 ∈ Ioo (0 : ℝ) 1 := by
  have hu0 : 0 < c * (t - startTime η₀ q₀ c j) := mul_pos hc (by linarith [ht.1])
  rw [curve_fst, mem_Ioo]
  rcases j with _ | i
  · have hub := travel_zero_lt (η₀ := η₀) (q₀ := q₀) (N := N) hc hN ht.2
    change 0 < q₀ + _ * _ ∧ q₀ + _ * _ < 1
    rcases hb : η₀.2 with _ | _
    · rw [show (RoutingLaw.itinerary F η₀ 0) = η₀ from rfl, sign_of_false hb]
      rw [show initialDistance η₀ q₀ = q₀ by unfold initialDistance; rw [hb]; rfl] at hub
      constructor <;> linarith [hq₀.1, hq₀.2]
    · rw [show (RoutingLaw.itinerary F η₀ 0) = η₀ from rfl, sign_of_true hb]
      rw [show initialDistance η₀ q₀ = 1 - q₀ by
        unfold initialDistance; rw [hb]; rfl] at hub
      constructor <;> linarith [hq₀.1, hq₀.2]
  · have hub := travel_succ_lt (η₀ := η₀) (q₀ := q₀) (N := N) hc hj ht.2
    rw [startCoord_succ_eq hlen]
    rcases hb : (F.itinerary η₀ (i + 1)).2 with _ | _
    · rw [sign_of_false hb, coordinate_of_false hb]
      constructor <;> linarith
    · rw [sign_of_true hb, coordinate_of_true hlen hb]
      constructor <;> linarith

/-- The last flight stops exactly halfway across its edge, strictly inside. -/
theorem curve_final (hlen : ∀ e : Γ.Edge, Γ.length e = 1) (hc : 0 < c) (hN : 1 ≤ N) :
    (curve F η₀ q₀ c N (stopTime η₀ q₀ c N N)).1 = 1 / 2 := by
  obtain ⟨i, rfl⟩ : ∃ i, N = i + 1 := ⟨N - 1, by omega⟩
  have hd : stopTime η₀ q₀ c (i + 1) (i + 1) - startTime η₀ q₀ c (i + 1) =
      crossingTime c / 2 := by
    rw [stopTime_self, startTime_succ]
    push_cast
    ring
  have hu : c * (stopTime η₀ q₀ c (i + 1) (i + 1) - startTime η₀ q₀ c (i + 1)) = 1 / 2 := by
    rw [hd]
    have := c_mul_crossingTime (c := c) hc
    linarith [this]
  rw [curve_fst, hu, startCoord_succ_eq hlen]
  rcases hb : (F.itinerary η₀ (i + 1)).2 with _ | _
  · rw [sign_of_false hb, coordinate_of_false hb]
    norm_num
  · rw [sign_of_true hb, coordinate_of_true hlen hb]
    norm_num

/-- A flight arrives exactly at the coordinate of its impact germ. -/
theorem curve_arrive (hlen : ∀ e : Γ.Edge, Γ.length e = 1) (hc : 0 < c) (hN : 1 ≤ N)
    {j : ℕ} (hj : j < N) :
    (curve F η₀ q₀ c j (stopTime η₀ q₀ c N j)).1 =
      EdgeEnd.coordinate Γ (F.itinerary η₀ j) := by
  rw [curve_fst]
  rcases j with _ | i
  · have hu : c * (stopTime η₀ q₀ c N 0 - startTime η₀ q₀ c 0) = initialDistance η₀ q₀ := by
      rw [stopTime_zero hN, startTime_zero, sub_zero]
      exact c_mul_firstDuration (η₀ := η₀) (q₀ := q₀) hc
    rw [hu]
    change q₀ + EdgeEnd.sign Γ η₀ * initialDistance η₀ q₀ = EdgeEnd.coordinate Γ η₀
    rcases hb : η₀.2 with _ | _
    · rw [sign_of_false hb, coordinate_of_false hb,
        show initialDistance η₀ q₀ = q₀ by unfold initialDistance; rw [hb]; rfl]
      ring
    · rw [sign_of_true hb, coordinate_of_true hlen hb,
        show initialDistance η₀ q₀ = 1 - q₀ by unfold initialDistance; rw [hb]; rfl]
      ring
  · have hu : c * (stopTime η₀ q₀ c N (i + 1) - startTime η₀ q₀ c (i + 1)) = 1 := by
      rw [stopTime_of_lt hj, startTime_succ]
      have h1 := c_mul_crossingTime (c := c) hc
      push_cast
      nlinarith
    rw [hu, startCoord_succ_eq hlen]
    rcases hb : (F.itinerary η₀ (i + 1)).2 with _ | _
    · rw [sign_of_false hb, coordinate_of_false hb]
      ring
    · rw [sign_of_true hb, coordinate_of_true hlen hb]
      ring

/-- The departure momentum after a passage is exactly the routed momentum. -/
theorem curve_depart_mom (hc : 0 < c) (j : ℕ) :
    momentum F η₀ c (j + 1) =
      F.departureMomentum (F.itinerary η₀ j) (momentum F η₀ c j) := by
  change EdgeEnd.sign Γ (F.itinerary η₀ (j + 1)) * c =
    -(EdgeEnd.sign Γ (F.routeGerm (F.itinerary η₀ j))) *
      |EdgeEnd.sign Γ (F.itinerary η₀ j) * c|
  rw [RoutingLaw.itinerary_succ, sign_otherEnd, abs_mul, RoutingLaw.edgeEnd_abs_sign,
    one_mul, abs_of_pos hc]

end FreeTrajectory

open FreeTrajectory

/-- **The free graph trajectory.**  On a unit-length metric graph with the zero potential, the
routing law `F`, an initial coordinate `q₀` strictly inside the edge of `η₀`, speed `c > 0` and
`N ≥ 1` impacts, free motion is a genuine deterministic graph-scattering trajectory. -/
noncomputable def freeGraphTrajectory (F : RoutingLaw Γ)
    (hlen : ∀ e : Γ.Edge, Γ.length e = 1) (η₀ : Γ.EdgeEnd) (q₀ c : ℝ)
    (hq₀ : q₀ ∈ Ioo (0 : ℝ) 1) (hc : 0 < c) (N : ℕ) (hN : 1 ≤ N) :
    GraphTrajectory (zeroPotential Γ) F where
  N := N
  start := startTime η₀ q₀ c
  stop := stopTime η₀ q₀ c N
  edge j := (F.itinerary η₀ j).1
  curve := FreeTrajectory.curve F η₀ q₀ c
  germ := F.itinerary η₀
  start_zero := startTime_zero
  start_lt_stop := by
    intro j hj
    rcases j with _ | i
    · rw [startTime_zero, stopTime_zero hN]
      exact firstDuration_pos (η₀ := η₀) hq₀ hc
    · have := duration_succ_pos (η₀ := η₀) (q₀ := q₀) (N := N) hc hj
      linarith
  stop_le_start_succ := by
    intro j hj
    rw [stopTime_of_lt hj, startTime_succ]
  start_succ_le := by
    intro j hj
    rw [startTime_succ, stopTime_of_lt hj]
    simp
  flight_ode := by
    intro j _
    refine ⟨fun _ => (momentum F η₀ c j, 0), fun t _ => ⟨?_, ?_⟩⟩
    · simp
    · have h1 : HasDerivAt
          (fun s : ℝ => startCoord F η₀ q₀ j + momentum F η₀ c j * (s - startTime η₀ q₀ c j))
          (momentum F η₀ c j) t := by
        simpa using
          (((hasDerivAt_id t).sub_const (startTime η₀ q₀ c j)).const_mul
            (momentum F η₀ c j)).const_add (startCoord F η₀ q₀ j)
      have h2 : HasDerivAt (fun _ : ℝ => momentum F η₀ c j) 0 t :=
        hasDerivAt_const t (momentum F η₀ c j)
      exact (h1.prodMk h2).hasDerivWithinAt
  flight_tube := by
    intro j hj t ht
    rw [hlen]
    simpa using curve_mem_Icc hlen hq₀ hc hN hj ht
  flight_inside := by
    intro j hj t ht
    rw [hlen]
    simpa using curve_mem_Ioo hlen hq₀ hc hN hj ht
  final_inside := by
    rw [hlen, curve_final hlen hc hN]
    norm_num
  germ_edge := fun _ _ => rfl
  arrive := by
    intro j hj
    simpa using curve_arrive hlen hc hN hj
  edge_succ := by
    intro j _
    -- `edge (j+1)` is by definition the first component of the routed germ.
    rw [RoutingLaw.itinerary_succ, otherEnd_fst]
  depart_coord := by
    intro j _
    change startCoord F η₀ q₀ (j + 1) + momentum F η₀ c (j + 1) *
      (startTime η₀ q₀ c (j + 1) - startTime η₀ q₀ c (j + 1)) = _
    change EdgeEnd.coordinate Γ (F.routeGerm (F.itinerary η₀ j)) + _ * _ = _
    simp
  depart_mom := by
    intro j _
    change |momentum F η₀ c (j + 1) - F.departureMomentum (F.itinerary η₀ j)
      (momentum F η₀ c j)| ≤ ChainParams.zero.momErr
    rw [curve_depart_mom (η₀ := η₀) (F := F) hc j]
    simp

end MechanicalPotential
end HamiltonianMetricGraphs
