import HamiltonianMetricGraphs.Realization.FreeGraphTrajectory

/-!
# Free graph trajectories on an arbitrary finite metric graph

`FreeGraphTrajectory.lean` builds the deterministic graph-scattering trajectory of the zero
potential on a graph all of whose edges have length `1`.  The universal realization theorem needs
the same construction for **arbitrary** edge lengths, because the microscopic corridor of a
routing component is the concatenation of the edges of that component, and their lengths are
whatever `Γ.length` says.

Everything is explicit: the itinerary of impact germs is generated by the routing law, flight `j`
traverses the whole edge `(F.itinerary η₀ j).1` (the first flight only the distance from `q₀` to
its impact germ), the momentum is `σ(η_j) c`, and the impacts are instantaneous.  Nothing is
assumed; Hamilton's equations hold exactly because the force of the zero potential vanishes.

Mathematical proof step: the deterministic graph-scattering trajectory whose microscopic
realization is the goal of the universal theorem.
-/

namespace HamiltonianMetricGraphs

open Set FiniteMetricGraph

variable {Γ : FiniteMetricGraph}

/-! ### Endpoint arithmetic for arbitrary lengths -/

/-- The coordinate of a `true` endpoint germ is the length of its edge. -/
theorem coordinate_of_true' {η : Γ.EdgeEnd} (h : η.2 = true) :
    EdgeEnd.coordinate Γ η = Γ.length η.1 := by
  change (if η.2 then Γ.length η.1 else 0) = _
  rw [h, if_pos rfl]

/-- The other endpoint germ carries the complementary coordinate. -/
theorem coordinate_otherEnd (η : Γ.EdgeEnd) :
    EdgeEnd.coordinate Γ (otherEnd η) = Γ.length η.1 - EdgeEnd.coordinate Γ η := by
  rcases hb : η.2 with _ | _
  · rw [coordinate_of_true' (show (otherEnd η).2 = true by simp [hb]), coordinate_of_false hb]
    simp [otherEnd]
  · rw [coordinate_of_false (show (otherEnd η).2 = false by simp [hb]), coordinate_of_true' hb]
    simp

/-- The length of the edge carrying flight `j` of the itinerary. -/
noncomputable def edgeLen (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) (j : ℕ) : ℝ :=
  Γ.length (F.itinerary η₀ j).1

theorem edgeLen_pos (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) (j : ℕ) : 0 < edgeLen F η₀ j :=
  Γ.length_pos _

theorem edgeLen_def (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) (j : ℕ) :
    edgeLen F η₀ j = Γ.length (F.itinerary η₀ j).1 := rfl

@[simp] theorem edgeLen_zero (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) :
    edgeLen F η₀ 0 = Γ.length η₀.1 := rfl

/-! ### The trajectory -/

namespace MechanicalPotential

namespace GenTrajectory

variable (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) (q₀ c : ℝ) (N : ℕ)

/-- The distance travelled by flight `j`: the distance from `q₀` to the first impact germ for the
first flight, and a whole edge for every later one. -/
noncomputable def travel : ℕ → ℝ
  | 0 => if η₀.2 then Γ.length η₀.1 - q₀ else q₀
  | j + 1 => edgeLen F η₀ (j + 1)

/-- The start time of flight `j`. -/
noncomputable def startTime : ℕ → ℝ
  | 0 => 0
  | j + 1 => startTime j + travel F η₀ q₀ j / c

/-- The end time of flight `j`: the impact time for `j < N`, and the middle of the last flight
for `j = N` (so that the trajectory ends strictly inside its tube). -/
noncomputable def stopTime (j : ℕ) : ℝ :=
  if j < N then startTime F η₀ q₀ c (j + 1)
  else startTime F η₀ q₀ c N + travel F η₀ q₀ N / (2 * c)

/-- The coordinate at which flight `j` starts. -/
noncomputable def startCoord : ℕ → ℝ
  | 0 => q₀
  | j + 1 => EdgeEnd.coordinate Γ (F.routeGerm (F.itinerary η₀ j))

/-- The (constant) momentum during flight `j`: the speed `c` oriented towards the germ `η_j`. -/
noncomputable def momentum (j : ℕ) : ℝ := EdgeEnd.sign Γ (F.itinerary η₀ j) * c

/-- The longitudinal state during flight `j`. -/
noncomputable def curve (j : ℕ) (t : ℝ) : ℝ × ℝ :=
  (startCoord F η₀ q₀ j + momentum F η₀ c j * (t - startTime F η₀ q₀ c j),
    momentum F η₀ c j)

variable {F η₀ q₀ c N}

@[simp] theorem curve_snd (j : ℕ) (t : ℝ) :
    (curve F η₀ q₀ c j t).2 = momentum F η₀ c j := rfl

@[simp] theorem startCoord_zero : startCoord F η₀ q₀ 0 = q₀ := rfl

theorem curve_fst (j : ℕ) (t : ℝ) :
    (curve F η₀ q₀ c j t).1 = startCoord F η₀ q₀ j +
      EdgeEnd.sign Γ (F.itinerary η₀ j) * (c * (t - startTime F η₀ q₀ c j)) := by
  change startCoord F η₀ q₀ j + momentum F η₀ c j * (t - startTime F η₀ q₀ c j) = _
  unfold momentum
  ring

/-! #### Elementary facts about the travelled distances and times -/

theorem travel_zero_of_false (h : η₀.2 = false) : travel F η₀ q₀ 0 = q₀ := by
  show (if η₀.2 then Γ.length η₀.1 - q₀ else q₀) = q₀
  simp [h]

theorem travel_zero_of_true (h : η₀.2 = true) :
    travel F η₀ q₀ 0 = Γ.length η₀.1 - q₀ := by
  show (if η₀.2 then Γ.length η₀.1 - q₀ else q₀) = _
  simp [h]

@[simp] theorem travel_succ (j : ℕ) : travel F η₀ q₀ (j + 1) = edgeLen F η₀ (j + 1) := rfl

theorem travel_pos (hq₀ : q₀ ∈ Ioo (0 : ℝ) (Γ.length η₀.1)) (j : ℕ) :
    0 < travel F η₀ q₀ j := by
  cases j with
  | zero =>
      rcases hb : η₀.2 with _ | _
      · rw [travel_zero_of_false hb]; exact hq₀.1
      · rw [travel_zero_of_true hb]; linarith [hq₀.2]
  | succ i => rw [travel_succ]; exact edgeLen_pos F η₀ (i + 1)

theorem travel_le_edgeLen (hq₀ : q₀ ∈ Ioo (0 : ℝ) (Γ.length η₀.1)) (j : ℕ) :
    travel F η₀ q₀ j ≤ edgeLen F η₀ j := by
  cases j with
  | zero =>
      rw [edgeLen_zero]
      rcases hb : η₀.2 with _ | _
      · rw [travel_zero_of_false hb]; linarith [hq₀.2]
      · rw [travel_zero_of_true hb]; linarith [hq₀.1]
  | succ i => rw [travel_succ]

@[simp] theorem startTime_zero : startTime F η₀ q₀ c 0 = 0 := rfl

theorem startTime_succ (j : ℕ) :
    startTime F η₀ q₀ c (j + 1) = startTime F η₀ q₀ c j + travel F η₀ q₀ j / c := rfl

theorem stopTime_of_lt {j : ℕ} (h : j < N) :
    stopTime F η₀ q₀ c N j = startTime F η₀ q₀ c (j + 1) := by
  rw [stopTime, if_pos h]

theorem stopTime_self :
    stopTime F η₀ q₀ c N N = startTime F η₀ q₀ c N + travel F η₀ q₀ N / (2 * c) := by
  rw [stopTime, if_neg (lt_irrefl N)]

/-- The distance travelled over the whole flight `j`, for `j < N`. -/
theorem c_mul_duration_of_lt (hc : 0 < c) {j : ℕ} (h : j < N) :
    c * (stopTime F η₀ q₀ c N j - startTime F η₀ q₀ c j) = travel F η₀ q₀ j := by
  rw [stopTime_of_lt h, startTime_succ]
  field_simp
  ring

/-- The distance travelled over the last flight is half of its edge portion. -/
theorem c_mul_duration_self (hc : 0 < c) :
    c * (stopTime F η₀ q₀ c N N - startTime F η₀ q₀ c N) = travel F η₀ q₀ N / 2 := by
  rw [stopTime_self]
  field_simp
  ring

theorem startTime_lt_stopTime (hq₀ : q₀ ∈ Ioo (0 : ℝ) (Γ.length η₀.1)) (hc : 0 < c) {j : ℕ}
    (hj : j ≤ N) : startTime F η₀ q₀ c j < stopTime F η₀ q₀ c N j := by
  rcases lt_or_eq_of_le hj with h | h
  · have he := c_mul_duration_of_lt (F := F) (η₀ := η₀) (q₀ := q₀) (N := N) hc h
    nlinarith [travel_pos (F := F) hq₀ j]
  · subst h
    have he := c_mul_duration_self (F := F) (η₀ := η₀) (q₀ := q₀) (N := j) hc
    nlinarith [travel_pos (F := F) hq₀ j]

/-- The distance travelled by time `t` inside flight `j` is at most the length of that flight. -/
theorem travelled_le (hq₀ : q₀ ∈ Ioo (0 : ℝ) (Γ.length η₀.1)) (hc : 0 < c) {j : ℕ} (hj : j ≤ N)
    {t : ℝ} (ht : t ≤ stopTime F η₀ q₀ c N j) :
    c * (t - startTime F η₀ q₀ c j) ≤ travel F η₀ q₀ j := by
  rcases lt_or_eq_of_le hj with h | h
  · have he := c_mul_duration_of_lt (F := F) (η₀ := η₀) (q₀ := q₀) (N := N) hc h
    nlinarith
  · subst h
    have he := c_mul_duration_self (F := F) (η₀ := η₀) (q₀ := q₀) (N := j) hc
    nlinarith [travel_pos (F := F) hq₀ j]

/-- Strict version of `travelled_le`. -/
theorem travelled_lt (hq₀ : q₀ ∈ Ioo (0 : ℝ) (Γ.length η₀.1)) (hc : 0 < c) {j : ℕ} (hj : j ≤ N)
    {t : ℝ} (ht : t < stopTime F η₀ q₀ c N j) :
    c * (t - startTime F η₀ q₀ c j) < travel F η₀ q₀ j := by
  rcases lt_or_eq_of_le hj with h | h
  · have he := c_mul_duration_of_lt (F := F) (η₀ := η₀) (q₀ := q₀) (N := N) hc h
    nlinarith
  · subst h
    have he := c_mul_duration_self (F := F) (η₀ := η₀) (q₀ := q₀) (N := j) hc
    nlinarith [travel_pos (F := F) hq₀ j]

/-! #### The starting coordinate of a later flight -/

/-- Flight `j + 1` starts at the end opposite to the germ it will reach. -/
theorem startCoord_succ_eq (j : ℕ) :
    startCoord F η₀ q₀ (j + 1) =
      edgeLen F η₀ (j + 1) - EdgeEnd.coordinate Γ (F.itinerary η₀ (j + 1)) := by
  change EdgeEnd.coordinate Γ (F.routeGerm (F.itinerary η₀ j)) = _
  rw [F.routeGerm_itinerary, coordinate_otherEnd]
  rfl

/-! #### Confinement to the edge -/

/-- The state of a flight at travelled distance `u`, in the two orientations. -/
theorem curve_fst_eq_zero_case (hb : η₀.2 = false) (t : ℝ) :
    (curve F η₀ q₀ c 0 t).1 = q₀ - c * (t - startTime F η₀ q₀ c 0) := by
  rw [curve_fst, startCoord_zero, show (F.itinerary η₀ 0) = η₀ from rfl, sign_of_false hb]
  ring

theorem curve_fst_eq_zero_case' (hb : η₀.2 = true) (t : ℝ) :
    (curve F η₀ q₀ c 0 t).1 = q₀ + c * (t - startTime F η₀ q₀ c 0) := by
  rw [curve_fst, startCoord_zero, show (F.itinerary η₀ 0) = η₀ from rfl, sign_of_true hb]
  ring

theorem curve_fst_eq_succ_case {i : ℕ} (hb : (F.itinerary η₀ (i + 1)).2 = false) (t : ℝ) :
    (curve F η₀ q₀ c (i + 1) t).1 =
      edgeLen F η₀ (i + 1) - c * (t - startTime F η₀ q₀ c (i + 1)) := by
  rw [curve_fst, startCoord_succ_eq, sign_of_false hb, coordinate_of_false hb]
  ring

theorem curve_fst_eq_succ_case' {i : ℕ} (hb : (F.itinerary η₀ (i + 1)).2 = true) (t : ℝ) :
    (curve F η₀ q₀ c (i + 1) t).1 = c * (t - startTime F η₀ q₀ c (i + 1)) := by
  rw [curve_fst, startCoord_succ_eq, sign_of_true hb, coordinate_of_true' hb]
  change edgeLen F η₀ (i + 1) - edgeLen F η₀ (i + 1) + _ = _
  ring

theorem curve_mem_Icc (hq₀ : q₀ ∈ Ioo (0 : ℝ) (Γ.length η₀.1)) (hc : 0 < c) {j : ℕ} (hj : j ≤ N)
    {t : ℝ} (ht : t ∈ Icc (startTime F η₀ q₀ c j) (stopTime F η₀ q₀ c N j)) :
    (curve F η₀ q₀ c j t).1 ∈ Icc (0 : ℝ) (edgeLen F η₀ j) := by
  have hu0 : 0 ≤ c * (t - startTime F η₀ q₀ c j) := mul_nonneg hc.le (by linarith [ht.1])
  have hub := travelled_le (F := F) (η₀ := η₀) (q₀ := q₀) (N := N) hq₀ hc hj ht.2
  cases j with
  | zero =>
      rw [edgeLen_zero]
      rcases hb : η₀.2 with _ | _
      · rw [curve_fst_eq_zero_case hb, travel_zero_of_false hb] at *
        exact ⟨by linarith, by linarith [hq₀.2]⟩
      · rw [curve_fst_eq_zero_case' hb, travel_zero_of_true hb] at *
        exact ⟨by linarith [hq₀.1], by linarith⟩
  | succ i =>
      rw [travel_succ] at hub
      rcases hb : (F.itinerary η₀ (i + 1)).2 with _ | _
      · rw [curve_fst_eq_succ_case hb]
        exact ⟨by linarith, by linarith⟩
      · rw [curve_fst_eq_succ_case' hb]
        exact ⟨by linarith, by linarith⟩

theorem curve_mem_Ioo (hq₀ : q₀ ∈ Ioo (0 : ℝ) (Γ.length η₀.1)) (hc : 0 < c) {j : ℕ} (hj : j ≤ N)
    {t : ℝ} (ht : t ∈ Ioo (startTime F η₀ q₀ c j) (stopTime F η₀ q₀ c N j)) :
    (curve F η₀ q₀ c j t).1 ∈ Ioo (0 : ℝ) (edgeLen F η₀ j) := by
  have hu0 : 0 < c * (t - startTime F η₀ q₀ c j) := mul_pos hc (by linarith [ht.1])
  have hub := travelled_lt (F := F) (η₀ := η₀) (q₀ := q₀) (N := N) hq₀ hc hj ht.2
  cases j with
  | zero =>
      rw [edgeLen_zero]
      rcases hb : η₀.2 with _ | _
      · rw [curve_fst_eq_zero_case hb, travel_zero_of_false hb] at *
        exact ⟨by linarith, by linarith [hq₀.2]⟩
      · rw [curve_fst_eq_zero_case' hb, travel_zero_of_true hb] at *
        exact ⟨by linarith [hq₀.1], by linarith⟩
  | succ i =>
      rw [travel_succ] at hub
      rcases hb : (F.itinerary η₀ (i + 1)).2 with _ | _
      · rw [curve_fst_eq_succ_case hb]
        exact ⟨by linarith, by linarith⟩
      · rw [curve_fst_eq_succ_case' hb]
        exact ⟨by linarith, by linarith⟩

/-- A flight arrives exactly at the coordinate of its impact germ. -/
theorem curve_arrive (hc : 0 < c) {j : ℕ} (hj : j < N) :
    (curve F η₀ q₀ c j (stopTime F η₀ q₀ c N j)).1 =
      EdgeEnd.coordinate Γ (F.itinerary η₀ j) := by
  have hu := c_mul_duration_of_lt (F := F) (η₀ := η₀) (q₀ := q₀) (N := N) hc hj
  cases j with
  | zero =>
      simp only [RoutingLaw.itinerary_zero]
      rcases hb : η₀.2 with _ | _
      · rw [curve_fst_eq_zero_case hb, hu, travel_zero_of_false hb, coordinate_of_false hb]
        ring
      · rw [curve_fst_eq_zero_case' hb, hu, travel_zero_of_true hb, coordinate_of_true' hb]
        ring
  | succ i =>
      rw [travel_succ] at hu
      rcases hb : (F.itinerary η₀ (i + 1)).2 with _ | _
      · rw [curve_fst_eq_succ_case hb, hu, coordinate_of_false hb]
        ring
      · rw [curve_fst_eq_succ_case' hb, hu, coordinate_of_true' hb]
        rfl

/-- The last flight stops strictly inside its edge. -/
theorem curve_final (hq₀ : q₀ ∈ Ioo (0 : ℝ) (Γ.length η₀.1)) (hc : 0 < c) :
    (curve F η₀ q₀ c N (stopTime F η₀ q₀ c N N)).1 ∈ Ioo (0 : ℝ) (edgeLen F η₀ N) := by
  have hu := c_mul_duration_self (F := F) (η₀ := η₀) (q₀ := q₀) (N := N) hc
  have hpos := travel_pos (F := F) hq₀ N
  have hle := travel_le_edgeLen (F := F) hq₀ N
  cases hN : N with
  | zero =>
      subst hN
      rw [edgeLen_zero]
      rcases hb : η₀.2 with _ | _
      · rw [curve_fst_eq_zero_case hb]
        rw [travel_zero_of_false hb] at hu hpos hle
        rw [edgeLen_zero] at hle
        exact ⟨by linarith, by linarith⟩
      · rw [curve_fst_eq_zero_case' hb]
        rw [travel_zero_of_true hb] at hu hpos hle
        rw [edgeLen_zero] at hle
        exact ⟨by linarith, by linarith⟩
  | succ i =>
      subst hN
      rw [travel_succ] at hu hpos hle
      rcases hb : (F.itinerary η₀ (i + 1)).2 with _ | _
      · rw [curve_fst_eq_succ_case hb]
        exact ⟨by linarith, by linarith⟩
      · rw [curve_fst_eq_succ_case' hb]
        exact ⟨by linarith, by linarith⟩

/-- The departure momentum after a passage is exactly the routed momentum. -/
theorem curve_depart_mom (hc : 0 < c) (j : ℕ) :
    momentum F η₀ c (j + 1) =
      F.departureMomentum (F.itinerary η₀ j) (momentum F η₀ c j) := by
  change EdgeEnd.sign Γ (F.itinerary η₀ (j + 1)) * c =
    -(EdgeEnd.sign Γ (F.routeGerm (F.itinerary η₀ j))) *
      |EdgeEnd.sign Γ (F.itinerary η₀ j) * c|
  rw [RoutingLaw.itinerary_succ, sign_otherEnd, abs_mul, RoutingLaw.edgeEnd_abs_sign,
    one_mul, abs_of_pos hc]

end GenTrajectory

open GenTrajectory

/-- **The free graph trajectory on an arbitrary finite metric graph.**  With the zero potential,
the routing law `F`, an initial coordinate `q₀` strictly inside the edge of `η₀`, speed `c > 0`
and `N` impacts, free motion is a genuine deterministic graph-scattering trajectory. -/
noncomputable def genTrajectory (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) (q₀ c : ℝ)
    (hq₀ : q₀ ∈ Ioo (0 : ℝ) (Γ.length η₀.1)) (hc : 0 < c) (N : ℕ) :
    GraphTrajectory (zeroPotential Γ) F where
  N := N
  start := startTime F η₀ q₀ c
  stop := stopTime F η₀ q₀ c N
  edge j := (F.itinerary η₀ j).1
  curve := GenTrajectory.curve F η₀ q₀ c
  germ := F.itinerary η₀
  start_zero := startTime_zero
  start_lt_stop := fun _ hj => startTime_lt_stopTime hq₀ hc hj
  stop_le_start_succ := fun _ hj => le_of_eq (stopTime_of_lt hj)
  start_succ_le := fun _ hj => by rw [stopTime_of_lt hj]; simp
  flight_ode := by
    intro j _
    refine ⟨fun _ => (momentum F η₀ c j, 0), fun t _ => ⟨?_, ?_⟩⟩
    · simp
    · have h1 : HasDerivAt
          (fun s : ℝ => startCoord F η₀ q₀ j +
            momentum F η₀ c j * (s - startTime F η₀ q₀ c j)) (momentum F η₀ c j) t := by
        simpa using
          (((hasDerivAt_id t).sub_const (startTime F η₀ q₀ c j)).const_mul
            (momentum F η₀ c j)).const_add (startCoord F η₀ q₀ j)
      have h2 : HasDerivAt (fun _ : ℝ => momentum F η₀ c j) 0 t :=
        hasDerivAt_const t (momentum F η₀ c j)
      exact (h1.prodMk h2).hasDerivWithinAt
  flight_tube := by
    intro j hj t ht
    have h := curve_mem_Icc (N := N) hq₀ hc hj ht
    rw [edgeLen_def] at h
    simpa using h
  flight_inside := by
    intro j hj t ht
    have h := curve_mem_Ioo (N := N) hq₀ hc hj ht
    rw [edgeLen_def] at h
    simpa using h
  final_inside := by
    have h := curve_final (F := F) (η₀ := η₀) (q₀ := q₀) (c := c) (N := N) hq₀ hc
    rw [edgeLen_def] at h
    simpa using h
  germ_edge := fun _ _ => rfl
  arrive := by
    intro j hj
    rw [curve_arrive (N := N) (η₀ := η₀) (q₀ := q₀) hc hj]
    simp
  edge_succ := by
    intro j _
    rw [RoutingLaw.itinerary_succ, otherEnd_fst]
  depart_coord := by
    intro j _
    change startCoord F η₀ q₀ (j + 1) + momentum F η₀ c (j + 1) *
      (startTime F η₀ q₀ c (j + 1) - startTime F η₀ q₀ c (j + 1)) = _
    change EdgeEnd.coordinate Γ (F.routeGerm (F.itinerary η₀ j)) + _ * _ = _
    simp
  depart_mom := by
    intro j _
    change |momentum F η₀ c (j + 1) - F.departureMomentum (F.itinerary η₀ j)
      (momentum F η₀ c j)| ≤ ChainParams.zero.momErr
    rw [curve_depart_mom (η₀ := η₀) (F := F) hc j]
    simp

end MechanicalPotential

end HamiltonianMetricGraphs
