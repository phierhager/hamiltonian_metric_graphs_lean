import HamiltonianMetricGraphs.Realization.UniversalGraphTrajectory

/-!
# The corridor layout of a routing component

Fix a finite metric graph `Γ`, a speed-independent involutive routing law `F` and a first impact
germ `η₀`.  The itinerary `η_j = F.itinerary η₀ j` is generated by the bijection
`σ = otherEnd ∘ F.routeGerm` of the finite set of edge-end germs; the microscopic model lays the
edges it visits out along **one straight corridor**.

The layout is the pair of sequences

* `dirSign j ∈ {±1}` — the direction in which flight `j` runs along the corridor.  It reverses
  exactly at a **fold**, i.e. at an impact `j` with `F(η_j) = η_j`, which is a `U`-turn of the
  routing law;
* `vpos j` — the corridor coordinate of the vertex at which flight `j` arrives, obtained by
  concatenating the edge lengths in the direction `dirSign`.

The two structural facts proved here are

* the **retrace lemma**: after a fold the itinerary, the directions and the vertex positions are
  the exact mirror images of the ones before it (`itinerary_retrace`, `dirSign_retrace`,
  `vpos_retrace`).  This is the combinatorial form of the reversibility `ρ Φ ρ = Φ⁻¹` of a
  reversible dynamical system;
* **periodicity**: `σ` permutes a finite set, so the itinerary is purely periodic.

Together they show that the folds form an arithmetic progression and that the corridor is the
finite interval between the two fold positions — the two **caps** of the microscopic corridor.
-/

namespace HamiltonianMetricGraphs

open Set FiniteMetricGraph

variable {Γ : FiniteMetricGraph}

namespace RoutingLaw

/-! ### The itinerary as an iteration -/

/-- The one-step map of the itinerary: route at the arrival vertex and traverse the routed edge. -/
def step (F : RoutingLaw Γ) (η : Γ.EdgeEnd) : Γ.EdgeEnd := otherEnd (F.routeGerm η)

theorem step_injective (F : RoutingLaw Γ) : Function.Injective F.step := by
  intro η ζ h
  have h1 : F.routeGerm η = F.routeGerm ζ := by
    have := congrArg otherEnd h
    simpa [step] using this
  exact F.routeGerm_injective h1

theorem itinerary_eq_iterate (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) (j : ℕ) :
    F.itinerary η₀ j = F.step^[j] η₀ := by
  induction j with
  | zero => rfl
  | succ i ih => rw [itinerary_succ, ih, Function.iterate_succ_apply']; rfl

/-- **The itinerary is purely periodic.**  The step map is an injection of the finite set of
edge-end germs, hence a bijection, so its orbits are cycles. -/
theorem exists_period (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) :
    ∃ n : ℕ, 0 < n ∧ ∀ j, F.itinerary η₀ (j + n) = F.itinerary η₀ j := by
  obtain ⟨a, b, hab, hfe⟩ :=
    Finite.exists_ne_map_eq_of_infinite (fun j : ℕ => F.step^[j] η₀)
  rcases lt_or_gt_of_ne hab with h | h
  · refine ⟨b - a, by omega, ?_⟩
    have hb : b = a + (b - a) := by omega
    have key : F.step^[a] (F.step^[b - a] η₀) = F.step^[a] η₀ := by
      have h2 : F.step^[a] η₀ = F.step^[b] η₀ := hfe
      rw [hb, Function.iterate_add_apply] at h2
      exact h2.symm
    have h0 : F.step^[b - a] η₀ = η₀ := (F.step_injective.iterate a) key
    intro j
    rw [RoutingLaw.itinerary_eq_iterate, RoutingLaw.itinerary_eq_iterate,
      Function.iterate_add_apply, h0]
  · refine ⟨a - b, by omega, ?_⟩
    have ha : a = b + (a - b) := by omega
    have key : F.step^[b] (F.step^[a - b] η₀) = F.step^[b] η₀ := by
      have h2 : F.step^[a] η₀ = F.step^[b] η₀ := hfe
      rw [ha, Function.iterate_add_apply] at h2
      exact h2
    have h0 : F.step^[a - b] η₀ = η₀ := (F.step_injective.iterate b) key
    intro j
    rw [RoutingLaw.itinerary_eq_iterate, RoutingLaw.itinerary_eq_iterate,
      Function.iterate_add_apply, h0]

end RoutingLaw

/-! ### Folds -/

/-- Impact `j` is a **fold**: the routing law fixes the arrival germ, so the particle turns
around and retraces the edge it came from. -/
def IsFold (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) (j : ℕ) : Prop :=
  F.routeGerm (F.itinerary η₀ j) = F.itinerary η₀ j

instance (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) (j : ℕ) : Decidable (IsFold F η₀ j) :=
  inferInstanceAs (Decidable (F.routeGerm (F.itinerary η₀ j) = F.itinerary η₀ j))

/-- At a fold the next arrival germ is the other end of the same edge. -/
theorem itinerary_succ_of_fold {F : RoutingLaw Γ} {η₀ : Γ.EdgeEnd} {j : ℕ}
    (h : IsFold F η₀ j) : F.itinerary η₀ (j + 1) = otherEnd (F.itinerary η₀ j) := by
  rw [RoutingLaw.itinerary_succ, h]

/-! ### The layout sequences -/

/-- The direction in which flight `j` runs along the corridor: it reverses exactly at a fold. -/
noncomputable def dirSign (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) : ℕ → ℝ
  | 0 => 1
  | j + 1 => if IsFold F η₀ j then -dirSign F η₀ j else dirSign F η₀ j

/-- The corridor coordinate of the vertex at which flight `j` arrives.  The origin is the vertex
behind the initial point, i.e. the end of the initial edge opposite to `η₀`. -/
noncomputable def vpos (F : RoutingLaw Γ) (η₀ : Γ.EdgeEnd) : ℕ → ℝ
  | 0 => 0
  | j + 1 => vpos F η₀ j + dirSign F η₀ j * edgeLen F η₀ j

variable {F : RoutingLaw Γ} {η₀ : Γ.EdgeEnd}

@[simp] theorem dirSign_zero : dirSign F η₀ 0 = 1 := rfl

theorem dirSign_succ_of_fold {j : ℕ} (h : IsFold F η₀ j) :
    dirSign F η₀ (j + 1) = -dirSign F η₀ j := by
  rw [dirSign, if_pos h]

theorem dirSign_succ_of_not_fold {j : ℕ} (h : ¬ IsFold F η₀ j) :
    dirSign F η₀ (j + 1) = dirSign F η₀ j := by
  rw [dirSign, if_neg h]

theorem dirSign_eq_one_or_neg_one (j : ℕ) : dirSign F η₀ j = 1 ∨ dirSign F η₀ j = -1 := by
  induction j with
  | zero => exact Or.inl rfl
  | succ i ih =>
      by_cases h : IsFold F η₀ i
      · rw [dirSign_succ_of_fold h]
        rcases ih with h' | h' <;> rw [h'] <;> simp
      · rw [dirSign_succ_of_not_fold h]; exact ih

theorem dirSign_ne_zero (j : ℕ) : dirSign F η₀ j ≠ 0 := by
  rcases dirSign_eq_one_or_neg_one (F := F) (η₀ := η₀) j with h | h <;> rw [h] <;> norm_num

theorem abs_dirSign (j : ℕ) : |dirSign F η₀ j| = 1 := by
  rcases dirSign_eq_one_or_neg_one (F := F) (η₀ := η₀) j with h | h <;> rw [h] <;> norm_num

theorem dirSign_sq (j : ℕ) : dirSign F η₀ j * dirSign F η₀ j = 1 := by
  rcases dirSign_eq_one_or_neg_one (F := F) (η₀ := η₀) j with h | h <;> rw [h] <;> norm_num

@[simp] theorem vpos_zero : vpos F η₀ 0 = 0 := rfl

theorem vpos_succ (j : ℕ) :
    vpos F η₀ (j + 1) = vpos F η₀ j + dirSign F η₀ j * edgeLen F η₀ j := rfl

/-! ### The retrace lemma

After a fold at `k` the itinerary is the exact time reverse of the itinerary before it.  This is
the combinatorial form of reversibility: the routing law is an involution, so conjugating the
dynamics by the momentum reversal inverts it. -/

/-- **Retrace of the itinerary.** -/
theorem itinerary_retrace {k : ℕ} (hk : IsFold F η₀ k) :
    ∀ {i j : ℕ}, i + j = k → F.itinerary η₀ (k + 1 + j) = otherEnd (F.itinerary η₀ i) := by
  intro i j
  induction j generalizing i with
  | zero =>
      intro h
      have hik : k = i := by omega
      subst hik
      exact itinerary_succ_of_fold hk
  | succ m ih =>
      intro h
      have h' : i + 1 + m = k := by omega
      have hIH := ih h'
      have hstep : F.itinerary η₀ (k + 1 + (m + 1)) =
          otherEnd (F.routeGerm (F.itinerary η₀ (k + 1 + m))) := by
        rw [show k + 1 + (m + 1) = (k + 1 + m) + 1 from rfl, RoutingLaw.itinerary_succ]
      rw [hstep, hIH]
      have hoi : otherEnd (F.itinerary η₀ (i + 1)) = F.routeGerm (F.itinerary η₀ i) := by
        rw [RoutingLaw.itinerary_succ, otherEnd_otherEnd]
      rw [hoi, F.routeGerm_routeGerm]

/-- **Retrace of the edge lengths.** -/
theorem edgeLen_retrace {k : ℕ} (hk : IsFold F η₀ k) {i j : ℕ} (h : i + j = k) :
    edgeLen F η₀ (k + 1 + j) = edgeLen F η₀ i := by
  rw [edgeLen_def, edgeLen_def, itinerary_retrace hk h, otherEnd_fst]

/-- **Retrace of the folds.** -/
theorem isFold_retrace {k : ℕ} (hk : IsFold F η₀ k) {i j : ℕ} (h : i + 1 + j = k) :
    IsFold F η₀ (k + 1 + j) ↔ IsFold F η₀ i := by
  have hit : F.itinerary η₀ (k + 1 + j) = F.routeGerm (F.itinerary η₀ i) := by
    rw [itinerary_retrace hk h, RoutingLaw.itinerary_succ, otherEnd_otherEnd]
  constructor
  · intro hf
    have : F.routeGerm (F.routeGerm (F.itinerary η₀ i)) = F.routeGerm (F.itinerary η₀ i) := by
      rw [← hit]; exact hf
    rw [F.routeGerm_routeGerm] at this
    exact this.symm
  · intro hf
    change F.routeGerm (F.itinerary η₀ (k + 1 + j)) = F.itinerary η₀ (k + 1 + j)
    rw [hit, F.routeGerm_routeGerm]
    exact hf.symm

/-- **Retrace of the directions**: the direction after a fold is opposite to the mirrored one
before it. -/
theorem dirSign_retrace {k : ℕ} (hk : IsFold F η₀ k) :
    ∀ {i j : ℕ}, i + j = k → dirSign F η₀ (k + 1 + j) = -dirSign F η₀ i := by
  intro i j
  induction j generalizing i with
  | zero =>
      intro h
      have hik : k = i := by omega
      subst hik
      exact dirSign_succ_of_fold hk
  | succ m ih =>
      intro h
      have h' : i + 1 + m = k := by omega
      have hIH := ih h'
      have hidx : k + 1 + (m + 1) = (k + 1 + m) + 1 := rfl
      have hiff : IsFold F η₀ (k + 1 + m) ↔ IsFold F η₀ i := isFold_retrace hk h'
      by_cases hf : IsFold F η₀ i
      · rw [hidx, dirSign_succ_of_fold (hiff.mpr hf), hIH, dirSign_succ_of_fold hf]
        ring
      · rw [hidx, dirSign_succ_of_not_fold (fun hc => hf (hiff.mp hc)), hIH,
          dirSign_succ_of_not_fold hf]

/-- **Retrace of the vertex positions**: after a fold the particle revisits, in reverse order,
exactly the vertices it has already visited. -/
theorem vpos_retrace {k : ℕ} (hk : IsFold F η₀ k) :
    ∀ {i j : ℕ}, i + j = k → vpos F η₀ (k + 2 + j) = vpos F η₀ i := by
  intro i j
  induction j generalizing i with
  | zero =>
      intro h
      have hik : k = i := by omega
      subst hik
      have h1 : vpos F η₀ (k + 2) = vpos F η₀ (k + 1) +
          dirSign F η₀ (k + 1) * edgeLen F η₀ (k + 1) := rfl
      have h2 : dirSign F η₀ (k + 1) = -dirSign F η₀ k := dirSign_succ_of_fold hk
      have h3 : edgeLen F η₀ (k + 1) = edgeLen F η₀ k := edgeLen_retrace hk (i := k) (j := 0) rfl
      have h4 : vpos F η₀ (k + 1) = vpos F η₀ k + dirSign F η₀ k * edgeLen F η₀ k := rfl
      rw [h1, h2, h3, h4]
      ring
  | succ m ih =>
      intro h
      have h' : i + 1 + m = k := by omega
      have hIH := ih h'
      have hidx : k + 2 + (m + 1) = (k + 2 + m) + 1 := rfl
      have hshift : k + 2 + m = k + 1 + (m + 1) := by omega
      have hd : dirSign F η₀ (k + 2 + m) = -dirSign F η₀ i := by
        rw [hshift]; exact dirSign_retrace hk (by omega)
      have hl : edgeLen F η₀ (k + 2 + m) = edgeLen F η₀ i := by
        rw [hshift]; exact edgeLen_retrace hk (by omega)
      have hstep : vpos F η₀ ((k + 2 + m) + 1) =
          vpos F η₀ (k + 2 + m) + dirSign F η₀ (k + 2 + m) * edgeLen F η₀ (k + 2 + m) := rfl
      have hi : vpos F η₀ (i + 1) = vpos F η₀ i + dirSign F η₀ i * edgeLen F η₀ i := rfl
      rw [hidx, hstep, hd, hl, hIH, hi]
      ring

/-- The mirror form of `vpos_retrace`: the positions are symmetric about the fold point. -/
theorem vpos_mirror {k : ℕ} (hk : IsFold F η₀ k) {j : ℕ} (hj : j ≤ k + 1) :
    vpos F η₀ (k + 1 + j) = vpos F η₀ (k + 1 - j) := by
  cases j with
  | zero => rfl
  | succ m =>
      have h : (k + 1 - (m + 1)) + m = k := by omega
      have := vpos_retrace hk (i := k + 1 - (m + 1)) (j := m) h
      rw [show k + 1 + (m + 1) = k + 2 + m by omega]
      exact this

end HamiltonianMetricGraphs
